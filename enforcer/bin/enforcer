#!/usr/bin/env node
// enforcer CLI.
//   enforcer governor <decide|status|config|limit|verify|set|enable|disable|telemetry>   the governor core
//   enforcer login|logout|status|workspace                   sign in (wraps bin/login.mjs, bin/enforcer-workspace.mjs)
//   enforcer event <name>                                    one process per hook event: governor + graph handlers, merged
//   enforcer hook <event> [handler]                          graph worker hooks (self-gated)
// V8 compile cache (node >= 22.1): the governor's module graph loads in a few ms instead of tens.
try { process.getBuiltinModule?.('node:module')?.enableCompileCache?.(join(process.getBuiltinModule('node:os').tmpdir(), `enforcer-v8-${process.getuid?.() ?? 0}`)); } catch {}
const spawnSync = (...a) => process.getBuiltinModule('node:child_process').spawnSync(...a);
import { readFileSync, existsSync, appendFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { homedir } from 'node:os';
import { stateBase } from '../src/state.mjs';
import { graphContextLive, native, runEvent, EVENT_NAMES } from '../src/event.mjs';

const here = (p) => fileURLToPath(new URL(p, import.meta.url));
const [area, sub, ...rest] = process.argv.slice(2);

const GOV = ['decide', 'status', 'config', 'limit', 'verify', 'set', 'enable', 'disable', 'telemetry'];
const CHECKS = { rules: 'rulesOn', budget: 'budgetOn', policy: 'policyOn' };
// event -> graph handlers (src/graph/hooks), run in order
const HOOKS = {
  'session-start': ['session_start'],
  'pre-tool-use': ['attach_evidence'],
  'post-tool-use': ['track_run', 'capture_evidence', 'heartbeat'],
  'post-tool-use-failure': ['capture_evidence', 'heartbeat'],
  'pre-compact': ['remember_on_compact'],
  'stop': ['open_run_guard'],
};

if (area === 'login' || area === 'logout' || area === 'status' || area === 'workspace') {
  const args = area === 'workspace' ? [here('./enforcer-workspace.mjs'), ...(sub ? [sub] : []), ...rest]
    : [here('./login.mjs'), ...(area === 'login' ? (sub ? [sub] : []) : [area === 'status' ? 'status' : 'logout']), ...rest];
  const r = spawnSync(process.execPath, args, { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (area === 'doctor') {
  if (process.argv.includes('--bundle')) {
    const { writeBundle } = await import('../src/bundle.mjs');
    const b = await writeBundle({ network: false });
    process.stdout.write(`${b.path}\n${b.size} bytes\n`);
    process.exit(0);
  }
  const { doctor } = await import('../src/doctor.mjs');
  process.exit(await doctor());
}

if (area === 'event') {
  const code = await runEvent(sub);
  process.exit(code);
}

if (area === 'hook' && HOOKS[sub]) {
  let input = '';
  try { input = readFileSync(0, 'utf8'); } catch {}
  let ev = {};
  try { ev = JSON.parse(input || '{}') || {}; } catch {}
  if (sub === 'session-start') { // announce the governor (ENFORCER_GOVERNOR=1) even with no graph context
    if (process.env.CLAUDE_ENV_FILE) { try { appendFileSync(process.env.CLAUDE_ENV_FILE, 'export ENFORCER_GOVERNOR=1\n'); } catch {} }
    process.env.ENFORCER_GOVERNOR = '1';
  }
  if (sub !== 'session-start' && !graphContextLive(ev)) process.exit(0); // no graph context: no output
  const only = rest[0] ? rest[0].replace(/-/g, '_') : null;
  const handlers = HOOKS[sub].filter((h) => !only || h === only);
  const r = await native(handlers, ev, Date.now() + 9000);
  // exit only once stdout has drained: a pipe is asynchronous on macOS and process.exit() cut a long reply at 8192 bytes
  if (r.out) await new Promise((done) => process.stdout.write(JSON.stringify(r.out) + '\n', done));
  process.exit(r.code);
}

if (area === 'dispatch') {
  const { main: preflight } = await import('../src/preflight.mjs');
  if (sub === 'preflight') process.exit(await preflight(rest));
  const { main: dispatchMain } = await import('../src/dispatch-command.mjs');
  process.exit(await dispatchMain([sub, ...rest].filter((x) => x !== undefined)));
}

if (area === 'plan') {
  if (sub !== 'check') { process.stderr.write('usage: enforcer plan check <graph> [--repo-root dir]\n'); process.exit(2); }
  const { main: planCheckMain } = await import('../src/plan-check.mjs');
  process.exit(await planCheckMain(rest));
}

if (area === 'evidence') {
  const { main: evidenceMain } = await import('../src/evidence-run.mjs');
  process.exit(await evidenceMain([sub, ...rest].filter((x) => x !== undefined)));
}

if (area === 'land') {
  if (sub === undefined) { process.stderr.write('usage: enforcer land <pr> [-R owner/repo] [--timeout <s>]   waits for green, then merges\n'); process.exit(2); }
  const { main: landMain } = await import('../src/land.mjs');
  process.exit(await landMain([sub, ...rest]));
}

if (area === 'uninstall') {
  const { main: uninstallMain } = await import('../src/uninstall.mjs');
  process.exit(await uninstallMain([sub, ...rest].filter((x) => x !== undefined)));
}

if (area === 'governor' && GOV.includes(sub)) {
  let script = sub === 'decide' ? here('../lib/governor/bin/governor') : here('../lib/governor/core/report.mjs');
  let args = [sub, ...rest];
  if (sub === 'enable' || sub === 'disable') {
    const key = CHECKS[rest[0]];
    if (!key || rest.length !== 1) { process.stderr.write(`usage: enforcer governor ${sub} <${Object.keys(CHECKS).join('|')}>\n`); process.exit(1); }
    args = ['set', key, sub === 'enable' ? 'on' : 'off'];
  } else if (sub === 'telemetry') {
    script = here('../lib/governor/bin/telemetry.mjs');
    args = rest;
  }
  const r = spawnSync(process.execPath, [script, ...args], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (area === 'harness' && (sub === 'install' || sub === 'uninstall') && rest[0] === 'codex') {
  const g = await import('../src/codex-install.mjs');
  const opts = { dryRun: rest.includes('--dry-run') };
  const r = sub === 'install' ? g.install(opts) : g.uninstall(opts);
  process.exit(r.ok ? 0 : 1);
}

if (area === 'harness' && (sub === 'install' || sub === 'uninstall') && rest[0] === 'grok') {
  const g = await import('../src/grok-install.mjs');
  const opts = { dryRun: rest.includes('--dry-run'), yes: rest.includes('--yes') || rest.includes('-y') };
  const r = await (sub === 'install' ? g.install(opts) : g.uninstall(opts));
  process.exit(r.ok ? 0 : 1);
}

process.stderr.write(`usage: enforcer doctor\n       enforcer uninstall [--purge] [--yes]\n       enforcer login [args] | logout | status | workspace <list|switch|current>\n       enforcer event <${EVENT_NAMES.join('|')}>\n       enforcer governor <${GOV.join('|')}> [args]\n         set <name> <value> | enable|disable <${Object.keys(CHECKS).join('|')}> | telemetry [on|off|status]\n       enforcer harness <install|uninstall> <grok|codex> [--dry-run] [--yes]\n       enforcer hook <${Object.keys(HOOKS).join('|')}> [handler]\n`);
process.exit(2);
