#!/usr/bin/env node
// enforcer CLI.
//   enforcer governor <decide|status|config|limit|verify>   the governor core
//   enforcer login|logout|status|workspace                   sign in (wraps bin/login.mjs, bin/enforcer-workspace.mjs)
//   enforcer event <name>                                    one process per hook event: governor + graph handlers, merged
//   enforcer hook <event> [handler]                          graph worker hooks (self-gated)
// V8 compile cache (node >= 22.1): the governor's module graph loads in a few ms instead of tens.
try { process.getBuiltinModule?.('node:module')?.enableCompileCache?.(join(process.getBuiltinModule('node:os').tmpdir(), `enforcer-v8-${process.getuid?.() ?? 0}`)); } catch {}
const spawnSync = (...a) => process.getBuiltinModule('node:child_process').spawnSync(...a);
import { readFileSync, existsSync, appendFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { homedir } from 'node:os';
import { stateBase } from '../src/state.mjs';
import { graphContextLive, python3Missing, runEvent, EVENT_NAMES } from '../src/event.mjs';

const here = (p) => fileURLToPath(new URL(p, import.meta.url));
const [area, sub, ...rest] = process.argv.slice(2);

const GOV = ['decide', 'status', 'config', 'limit', 'verify'];
// event -> python handlers (lib/graph/<handler>.py), run in order
const HOOKS = {
  'session-start': ['session_start'],
  'pre-tool-use': ['attach_evidence'],
  'post-tool-use': ['track_run', 'capture_evidence', 'heartbeat'],
  'post-tool-use-failure': ['capture_evidence', 'heartbeat'],
  'pre-compact': ['remember_on_compact'],
  'stop': ['open_run_guard'],
};

if (area === 'login' || area === 'logout' || area === 'status' || area === 'workspace') {
  const args = area === 'workspace' ? [here('./enforcer-workspace.mjs'), ...(sub ? [sub] : []), ...rest]
    : [here('./login.mjs'), ...(area === 'login' ? (sub ? [sub] : []) : [area === 'status' ? 'status' : 'logout']), ...rest];
  const r = spawnSync(process.execPath, args, { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (area === 'doctor') {
  const { doctor } = await import('../src/doctor.mjs');
  process.exit(await doctor());
}

if (area === 'event') {
  const code = await runEvent(sub);
  process.exit(code);
}

if (area === 'hook' && HOOKS[sub]) {
  let input = '';
  try { input = readFileSync(0, 'utf8'); } catch {}
  let ev = {};
  try { ev = JSON.parse(input || '{}') || {}; } catch {}
  if (sub === 'session-start') { // announce the governor (ENFORCER_GOVERNOR=1) even with no graph context
    if (process.env.CLAUDE_ENV_FILE) { try { appendFileSync(process.env.CLAUDE_ENV_FILE, 'export ENFORCER_GOVERNOR=1\n'); } catch {} }
    process.env.ENFORCER_GOVERNOR = '1';
  }
  const GRAPH_STAMPED = sub === 'pre-tool-use' && /^mcp__(plugin_enforcer_enforcer|enforcer|enforcer-graph)__graph_(next_work|heartbeat|report)$/.test(ev.tool_name || '');
  const noPy = (sub === 'session-start' || GRAPH_STAMPED) && python3Missing(); // only where it matters: the no-context path stays fast
  if (noPy && sub === 'session-start') { // python is the hooks' runtime: say so where a person sees it
    const msg = 'enforcer: python3 is not on PATH, so the graph hooks (evidence capture, heartbeats, attestation) cannot run. Install python3, then run `enforcer doctor`. Graph calls are attested hooks=off:python3.';
    process.stdout.write(JSON.stringify({ systemMessage: msg, hookSpecificOutput: { hookEventName: 'SessionStart', additionalContext: msg } }) + '\n');
  }
  if (noPy && GRAPH_STAMPED) {
    const v = (() => { try { return JSON.parse(readFileSync(here('../plugin.json'), 'utf8')).version; } catch { return 'unknown'; } })();
    process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: 'PreToolUse', updatedInput: { ...(ev.tool_input || {}), client: `enforcer-graph-plugin/${v}; hooks=off:python3` } } }) + '\n');
    process.exit(0);
  }
  if (noPy) process.exit(0);
  if (!graphContextLive(ev)) process.exit(0); // no graph context: no output, no python
  const only = rest[0] ? rest[0].replace(/-/g, '_') : null;
  const handlers = HOOKS[sub].filter((h) => !only || h === only);
  let code = 0;
  for (const h of handlers) {
    const r = spawnSync('python3', [here(`../lib/graph/${h}.py`)], { input, stdio: ['pipe', 'inherit', 'inherit'] });
    if (r.status) code = r.status;
  }
  process.exit(code);
}

if (area === 'dispatch') {
  const { main: preflight } = await import('../src/preflight.mjs');
  if (sub === 'preflight') process.exit(await preflight(rest));
  if (sub === undefined || sub === '--help' || sub === '-h') {
    process.stdout.write('usage: enforcer dispatch preflight <graph> [--repo-root dir]\n       enforcer dispatch <graph> [graph-dispatch options]   preflight, then run bin/graph-dispatch\n');
    process.exit(sub === undefined ? 2 : 0);
  }
  const args = [sub, ...rest];
  const gi = args.indexOf('--graph');
  const graph = gi >= 0 ? args[gi + 1] : args.find((a) => !a.startsWith('-'));
  const ri = args.indexOf('--repo-root');
  const code = await preflight([graph, ...(ri >= 0 ? ['--repo-root', args[ri + 1]] : [])]);
  if (code !== 0) { process.stderr.write('enforcer dispatch: preflight failed, nothing started\n'); process.exit(code); }
  const dispatchArgs = gi >= 0 ? args : ['--graph', graph, ...args.filter((a) => a !== graph)];
  const r = spawnSync('python3', [here('./graph-dispatch'), ...dispatchArgs], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (area === 'plan') {
  if (sub !== 'check') { process.stderr.write('usage: enforcer plan check <graph> [--repo-root dir]\n'); process.exit(2); }
  const { main: planCheckMain } = await import('../src/plan-check.mjs');
  process.exit(await planCheckMain(rest));
}

if (area === 'land') {
  const script = here('./land-pr.sh');
  if (sub === undefined || sub === '--help' || sub === '-h') {
    process.stdout.write("usage: enforcer land <pr> [--timeout <s>]   runs this plugin's bin/land-pr.sh: waits for green, then merges\n");
    process.exit(sub === undefined ? 2 : 0);
  }
  const r = spawnSync(script, [sub, ...rest], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (area === 'governor' && GOV.includes(sub)) {
  const script = sub === 'decide' ? here('../lib/governor/bin/governor') : here('../lib/governor/core/report.mjs');
  const r = spawnSync(process.execPath, [script, sub, ...rest], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (area === 'harness' && (sub === 'install' || sub === 'uninstall') && rest[0] === 'codex') {
  const g = await import('../src/codex-install.mjs');
  const opts = { dryRun: rest.includes('--dry-run') };
  const r = sub === 'install' ? g.install(opts) : g.uninstall(opts);
  process.exit(r.ok ? 0 : 1);
}

if (area === 'harness' && (sub === 'install' || sub === 'uninstall') && rest[0] === 'grok') {
  const g = await import('../src/grok-install.mjs');
  const opts = { dryRun: rest.includes('--dry-run'), yes: rest.includes('--yes') || rest.includes('-y') };
  const r = await (sub === 'install' ? g.install(opts) : g.uninstall(opts));
  process.exit(r.ok ? 0 : 1);
}

process.stderr.write(`usage: enforcer doctor\n       enforcer login [args] | logout | status | workspace <list|switch|current>\n       enforcer event <${EVENT_NAMES.join('|')}>\n       enforcer governor <${GOV.join('|')}> [args]\n       enforcer harness <install|uninstall> <grok|codex> [--dry-run] [--yes]\n       enforcer hook <${Object.keys(HOOKS).join('|')}> [handler]\n`);
process.exit(2);
