#!/usr/bin/env python3
"""graph-dispatch --graph <id> [--workers N] [--repo-root DIR] [--dry-run]

Keeps N graph workers busy on one enforcer-graph plan, with no model in the
loop. Each pass it reads the frontier (and nodes whose lease lapsed), and for
each ready node, up to N at once:

  * a merge node that names a PR (data.pr, or data.branch) is landed by
    bin/land-pr.sh with NO agent; the dispatcher claims the run, heartbeats it
    while land-pr waits, and completes it with land-pr's verbatim output as
    evidence (exit 0 succeeded; 2/3/4/5 failed with that output);
  * any other node gets a git worktree of data.repo under --repo-root on
    branch graph/<key>, and a headless `claude -p` running the plugin's
    graph-worker agent, which claims, heartbeats and reports the node itself
    (so the plugin's hooks capture its evidence).

Model: data.model if set; else data.tier (mechanical/standard -> sonnet,
deep -> opus) when tier_source is "user"; else --model if given (a cap);
else the tier; else sonnet.

Warm workers: each agent launch names its session (--session-id). When a
worker reports its node cleanly, its session is kept warm for its
(data.repo, model); the next node in that repo on that model resumes it
(--resume, new worktree, new node prompt) instead of starting cold, and
such nodes are scheduled first. A resume that fails to start falls back to
a cold start, logged, with no attempt spent. A session is retired after
--warm-max-nodes nodes (5) or --warm-max-age minutes (120); --no-warm turns
it off. data.max_turns is passed as --max-turns. The done line carries the
result's cache_read / cache_creation / output tokens.

A DENIED worker whose denial was a push or PR (never another tool), on a node whose
claim card lists the deliver-via-github-pr skill, is salvaged once
per node per session when its worktree is on graph/<key>, ahead of base, and clean:
the dispatcher pushes, opens the PR (the worker's final report as body), runs
land-pr.sh, then resumes the worker's session to claim again, run the gate and
report. Anything else logs SALVAGE-SKIPPED with the reason and is left for a person.
land-pr runs as a tracked child (it can wait an hour on CI): the loop keeps launching
other nodes meanwhile, the salvage counts against the node but not a worker slot, and
the session is resumed when land-pr exits.

Failure remediation. A failed attempt (reported failed, reported succeeded but
rejected, or exited without reporting; never a DENIED one, which takes the
salvage path) makes the node's next launch a REMEDIATION launch: it resumes the
failed attempt's own session (cold if that cannot start) and its prompt carries
the previous error, the last_rejection, and "fix the cause, not the symptom".
When --max-attempts (2) task attempts have all failed, the node is not launched
again; the dispatcher creates a triage node (data.triage_of) and runs a
--triage-model (deep tier) worker on it, once per node per session. The triage
worker reports ITS node with data.triage = revise | prerequisite | gate, and the
dispatcher makes the writes (a headless worker cannot): revise patches the
failed node (data.revised_by=triage); prerequisite creates the node(s) and a
`requires` edge from the failed node to each; gate creates gate-<key> naming
the decision and the `requires` edge that holds the node behind it. So: at most
2 task launches + 1 triage per node per session. --no-triage turns it off.
Triage covers EVERY failed node, whatever its type: a failed node of a type the
dispatcher never launches (ops, gate, release) with no live run is triaged too, so it
cannot sit failed forever. The worker never does that node's own work; it revises it
(revise may retype, e.g. ops -> task with verification-only acceptance), names what it
waits on (prerequisite: new nodes, or {key, existing: true}, each a `requires` edge),
or points at / creates the gate for the human decision. The mark data.triaged_at +
data.triaged_runs makes it idempotent: no re-triage until the node's runs change.

A worker whose result names a permission denial (a denied push, PR or tool,
or denial text in its result) is logged DENIED with its worktree path and is not
relaunched this session: the same wall would meet it again. Every worker runs
with JEV_HOOKS_HEADLESS=1.

Never two of our workers, or ours and a live run elsewhere, on one
data.resources value. A touch of the stop file (default <state>/STOP) drains:
no new launches, running workers finish, then exit. Per-worker logs in
<state>/logs. Exit codes: 0 done or drained, 1 API/auth error, 2 drained
because a worker was denied a graph tool (see README "Headless workers"),
5 usage.

Auth: GRAPH_AUTH_HELPER (a command printing JSON headers, e.g.
`node <plugin cache>/instruxi/enforcer/<v>/bin/enforcer-headers.mjs`;
default: the newest such file in the plugin cache), else GRAPH_API_KEY.
Base: GRAPH_BASE_URL (default https://api.instruxi.dev/api/v1/graph).
"""
import argparse
import datetime as dt
import glob
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import time
import uuid
import urllib.error
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib", "graph"))
import lib as graph_lib  # migrate_dir
from lib import claude_paths

HERE = os.path.dirname(os.path.abspath(__file__))
PLUGIN_DIR = os.path.dirname(HERE)
LAND_PR = os.path.join(HERE, "land-pr.sh")
ATTRIBUTION = "\U0001F916 Generated with [Claude Code](https://claude.com/claude-code)"
UA = "graph-dispatch/0.18 (enforcer-graph plugin)"
AGENT = "enforcer-graph:graph-worker"
GRAPH_TOOLS = ["graph_next_work", "graph_heartbeat", "graph_report", "graph_remember", "graph_plan_status"]
PREFIXES = ["mcp__plugin_enforcer_enforcer__", "mcp__enforcer__", "mcp__enforcer-graph__"]
BASE_TOOLS = ["Bash", "Read", "Edit", "Write", "Grep", "Glob", "ToolSearch"]
DEFAULT_TYPES = "task,bug,chore,merge,scout,milestone,ops"  # gate stays human
LEASE_KEY = "dispatcher-lease"
LEASE_TTL = 180  # seconds a lease outlives its last renewal
RETRY_STATUS = (429, 502, 503, 504)
TIER_MODEL = {"mechanical": "sonnet", "standard": "sonnet", "deep": "opus"}
CLIP = 4000
# A permission denial is the environment's answer, not the work's: relaunching
# the same worker meets the same wall and (server side) bumps the node's tier.
PUSH_DENIAL_RE = re.compile(r"git\s+push|gh\s+pr\b|\bpush(ed|ing)?\b.*\bdenied|\bdenied\b.*\b(push|pull request)", re.I | re.S)
DENIAL_TEXT_RE = re.compile(r"permission denied|was denied|were denied|denied by|requires? (permission|approval)|"
                            r"not (allowed|permitted) to|no approval|needs? approval|auto mode (classifier )?(denied|blocked)",
                            re.I)
TRANSIENT_RE = re.compile(r"temporary failure in name resolution|could not resolve host|connection (reset|refused|timed out)|"
                          r"timed? ?out|network is unreachable|tls handshake|unexpected eof|http (502|503|504)|"
                          r"error connecting to|name or service not known", re.I)
GRAPH_TOOL_RE = re.compile(r"__graph_(next_work|heartbeat|report|remember|plan_status)$")


# ---------------------------------------------------------------- pure rules

def model_for(node, override=None):
    """The model a node's worker runs on. Explicit data.model (or the claim
    card's model) wins; a user-set tier beats the dispatcher's --model cap;
    otherwise the cap, then the tier, then sonnet."""
    data = node.get("data") or {}
    explicit = data.get("model") or node.get("model")
    if explicit:
        return explicit
    tier = (data.get("tier") or node.get("tier") or "").lower()
    if data.get("tier_source") == "user" and tier in TIER_MODEL:
        return TIER_MODEL[tier]
    if override:
        return override
    return TIER_MODEL.get(tier, "sonnet")


def resources_of(node):
    r = (node.get("data") or {}).get("resources") or []
    if isinstance(r, str):
        r = [r]
    out = {str(x) for x in r if x}
    mt = merge_target(node)
    if mt:  # one land-pr per repo at a time: each would rebase onto a base the other moves
        out.add("land:" + str((node.get("data") or {}).get("repo") or mt[1] or "?"))
    return out


def lapsed(node, now=None):
    if node.get("status") != "running":
        return False
    exp = parse_ts(node.get("lease_expires_at"))
    return exp is not None and exp < (now or utcnow())


def select(candidates, held, slots, busy_keys=()):
    """Pick up to `slots` candidates in order, never two on one resource value:
    `held` is every resource already held (our workers and live runs
    elsewhere). Returns (chosen, skipped) with skipped as (node, reason)."""
    held = set(held)
    chosen, skipped = [], []
    for n in candidates:
        if n.get("key") in busy_keys:
            continue
        r = resources_of(n)
        clash = sorted(r & held)
        if clash:
            skipped.append((n, "resource held: " + ", ".join(clash)))
            continue
        if len(chosen) >= slots:
            skipped.append((n, "no free worker slot"))
            continue
        chosen.append(n)
        held |= r
    return chosen, skipped


def merge_target(node):
    """(pr, repo_slug) for a merge node that names a PR, else None.
    data.pr may be a number, a URL, or owner/repo#N; data.branch is resolved
    by land-pr (gh accepts a branch name) inside the repo checkout."""
    if node.get("type") != "merge":
        return None
    data = node.get("data") or {}
    pr = data.get("pr") or data.get("pr_url") or data.get("branch")
    if not pr:
        return None
    pr = str(pr)
    m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/(\d+)", pr)
    if m:
        return m.group(2), m.group(1)
    m = re.match(r"([\w.-]+/[\w.-]+)#(\d+)$", pr)
    if m:
        return m.group(2), m.group(1)
    return pr, None


def repo_of(node):
    return (node.get("data") or {}).get("repo") or None


class Session:
    """A claude session that finished a node cleanly and can be resumed for
    the next node in the same repo on the same model. `nodes` counts the
    nodes it has been launched for; `born` is its first launch."""

    def __init__(self, sid, repo, model, born=None):
        self.sid, self.repo, self.model = sid, repo, model
        self.born = born if born is not None else time.time()
        self.nodes = 0
        self.last_key = None
        self.cost = None  # the last total_cost_usd seen (cumulative across resumes)


def session_usable(sess, max_nodes, max_age_s, now=None):
    """(ok, why-not). A session is resumed for at most `max_nodes` nodes in
    all and never past `max_age_s` seconds from its first launch, so the
    context it carries (and its compaction debt) does not grow forever."""
    now = time.time() if now is None else now
    if sess.nodes >= max_nodes:
        return False, "%d node(s), cap %d" % (sess.nodes, max_nodes)
    age = now - sess.born
    if age >= max_age_s:
        return False, "%dm old, cap %dm" % (age // 60, max_age_s // 60)
    return True, ""


def affinity_order(candidates, warm, model_of):
    """Stable reorder: a node whose (repo, model) has an idle warm session
    goes first, as many per pair as there are sessions; the rest keep the
    server's order. `warm` maps (repo, model) -> idle session count."""
    left = dict(warm)
    first, rest = [], []
    for n in candidates:
        k = (repo_of(n), model_of(n))
        if k[0] and left.get(k, 0) > 0 and not merge_target(n):
            left[k] -= 1
            first.append(n)
        else:
            rest.append(n)
    return first + rest


def plugin_dirs(extra):
    """This plugin, then each --plugin-dir, once per directory (by real path)."""
    out, seen = [], set()
    for d in [PLUGIN_DIR] + list(extra or []):
        r = os.path.realpath(d)
        if r not in seen:
            seen.add(r)
            out.append(d)
    return out


def node_max_turns(node):
    try:
        v = int((node.get("data") or {}).get("max_turns") or 0)
    except (TypeError, ValueError):
        return None
    return v if v > 0 else None


def allowed_tools():
    return BASE_TOOLS + [p + t for p in PREFIXES for t in GRAPH_TOOLS]


def clip(s, n=CLIP):
    if len(s) <= n:
        return s
    half = n // 2 - 20
    return s[:half] + "\n…[clipped %d chars]…\n" % (len(s) - 2 * half) + s[-half:]


def utcnow():
    return dt.datetime.now(dt.timezone.utc)


def parse_ts(s):
    if not s:
        return None
    try:
        s = re.sub(r"(\.\d{6})\d+", r"\1", s.replace("Z", "+00:00"))
        return dt.datetime.fromisoformat(s)
    except ValueError:
        return None


# ---------------------------------------------------------------- API

class APIError(Exception):
    def __init__(self, status, body):
        super().__init__("HTTP %s: %s" % (status, body[:300]))
        self.status, self.body = status, body


def default_helper():
    found = sorted(glob.glob(claude_paths.plugin_cache_glob(
        "enforcer", "*", "bin", "enforcer-headers.mjs")),
        key=lambda p: [int(x) if x.isdigit() else x for x in re.split(r"[./]", p)])
    return "node " + shlex.quote(found[-1]) if found else None


class API:
    def __init__(self, base, helper=None, key=None):
        self.base = base.rstrip("/")
        self.helper, self.key = helper, key
        self.tries, self.backoff, self.sleep = 4, 1.0, time.sleep

    def headers(self):
        h = {"User-Agent": UA, "Content-Type": "application/json"}
        if self.helper:
            out = subprocess.run(self.helper, shell=True, capture_output=True, text=True, timeout=30)
            if out.returncode != 0:
                raise APIError("auth", "GRAPH_AUTH_HELPER failed: " + out.stderr.strip()[:300])
            h.update(json.loads(out.stdout))
        elif self.key:
            h["X-API-Key"] = self.key
        return h

    def call(self, method, path, body=None):
        last = None
        for i in range(self.tries):
            req = urllib.request.Request(self.base + path, method=method, headers=self.headers(),
                                         data=json.dumps(body).encode() if body is not None else None)
            try:
                with urllib.request.urlopen(req, timeout=60) as r:
                    return json.loads(r.read() or b"{}")
            except urllib.error.HTTPError as e:
                err = APIError(e.code, e.read().decode(errors="replace"))
                if e.code not in RETRY_STATUS:
                    raise err
                last = err
            except (OSError, ValueError) as e:  # URLError, DNS blips, resets, timeouts, truncated bodies
                last = APIError("network", "%s: %s" % (type(e).__name__, e))
            if i + 1 < self.tries:
                self.sleep(self.backoff * (2 ** i))
        raise last

    def frontier(self, g):
        return self.call("GET", "/graphs/%s/frontier" % g).get("data") or []

    def nodes(self, g):
        out, off = [], 0
        while True:
            d = self.call("GET", "/graphs/%s/nodes?limit=200&offset=%d" % (g, off))
            out += d.get("data") or []
            total = (d.get("meta") or {}).get("total", len(out))
            off += 200
            if off >= total or not d.get("data"):
                return out

    def claim(self, g, n, runner):
        d = self.call("POST", "/graphs/%s/nodes/%s/claim" % (g, n), {"runner": runner}).get("data")
        return d[0] if isinstance(d, list) else d

    def heartbeat(self, g, n, r):
        return self.call("POST", "/graphs/%s/nodes/%s/runs/%s/heartbeat" % (g, n, r), {})

    def complete(self, g, n, r, body):
        return self.call("POST", "/graphs/%s/nodes/%s/runs/%s/complete" % (g, n, r), body)

    # the writes a triage decision needs (a headless worker cannot make them:
    # every hosted write tool but the graph work loop asks a person)
    def create_node(self, g, body):
        d = self.call("POST", "/graphs/%s/nodes" % g, body).get("data")
        return d[0] if isinstance(d, list) else d

    def create_edge(self, g, body):
        return self.call("POST", "/graphs/%s/edges" % g, body).get("data")

    def patch_node(self, g, n, body):
        return self.call("PATCH", "/graphs/%s/nodes/%s" % (g, n), body).get("data")

    def runs(self, g, n):
        return self.call("GET", "/graphs/%s/nodes/%s/runs" % (g, n)).get("data") or []

    def node(self, g, n):
        d = self.call("GET", "/graphs/%s/nodes/%s" % (g, n)).get("data")
        return d[0] if isinstance(d, list) else d

    def observations(self, g, n):
        return self.call("GET", "/graphs/%s/nodes/%s/observations" % (g, n)).get("data") or []


# ---------------------------------------------------------------- workers

class Worker:
    kind = "agent"

    def __init__(self, node, log_path):
        self.node, self.key, self.log_path = node, node["key"], log_path
        self.proc, self.started = None, time.time()
        self.resources = resources_of(node)

    def alive(self):
        return self.proc is not None and self.proc.poll() is None


def git(args, cwd):
    return subprocess.run(["git"] + args, cwd=cwd, capture_output=True, text=True)


def worktree_for(node, repo_root, state_dir, dry=False):
    """(path, branch, note). A node with a data.repo checkout under repo_root
    gets <repo_root>/<repo>-<key> on graph/<key>, off data.base or origin's
    default branch; a re-claimed node reuses its worktree. A node with no repo
    works in a plain scratch directory."""
    key = node["key"]
    data = node.get("data") or {}
    repo = data.get("repo")
    branch = "graph/" + key
    if not repo or not repo_root or not os.path.isdir(os.path.join(repo_root, repo, ".git")) and \
            not os.path.isfile(os.path.join(repo_root, repo, ".git")):
        path = os.path.join(state_dir, "work", key)
        if not dry:
            os.makedirs(path, exist_ok=True)
        why = "no data.repo" if not repo else "no checkout of %s under %s" % (repo, repo_root)
        return path, None, "scratch dir (%s)" % why
    src = os.path.join(repo_root, repo)
    path = os.path.join(repo_root, "%s-%s" % (repo, key))
    if os.path.isdir(path):
        return path, branch, "reused"
    base = data.get("base")
    if not base:
        h = git(["symbolic-ref", "--short", "refs/remotes/origin/HEAD"], src).stdout.strip()
        base = h or "origin/main"
    elif not base.startswith("origin/"):
        base = "origin/" + base
    if dry:
        return path, branch, "would add off " + base
    git(["fetch", "-q", "origin"], src)
    r = git(["worktree", "add", path, "-b", branch, base], src)
    if r.returncode != 0:  # the branch exists from an earlier attempt
        r = git(["worktree", "add", path, branch], src)
    if r.returncode != 0:
        raise RuntimeError("worktree add failed: " + (r.stderr or r.stdout).strip()[:300])
    return path, branch, "added off " + base


def worker_prompt(graph, node, path, branch, previous=None):
    data = node.get("data") or {}
    lines = []
    if previous:
        lines.append("NEW NODE. Your previous node (`%s`) is finished and reported: its run is closed, do not "
                     "touch its worktree or report it again. Keep what you learned about this repo, but take "
                     "every fact about THIS node from its card." % previous)
    lines += ["Graph %s, node %s (key `%s`): %s." % (graph, node["id"], node["key"], node.get("title", "")),
             "Claim it with graph_next_work {graph, node: \"%s\", runner: \"%s\"} and work it per your instructions."
             % (node["id"], node["key"])]
    if branch:
        lines.append("Your git worktree is %s on branch %s (already created; work only there)." % (path, branch))
    else:
        lines.append("Your working directory is %s." % path)
    if data.get("brief"):
        lines.append("Brief: " + str(data["brief"]))
    return "\n".join(lines)


HARNESSES = ("claude", "codex", "grok")


def launch_grok(prompt, model, args, key):
    """grok -p <prompt> --output-format json: one JSON object at the end of the run."""
    cmd = [getattr(args, "grok", None) or os.environ.get("GROK_BIN", "grok"), "-p", prompt,
           "--output-format", "json"]
    if model:
        cmd += ["--model", model]
    return cmd


def launch_codex(prompt, model, args, key):
    """codex exec --json <prompt>: JSONL events. The parser is a stub until a real sample exists."""
    cmd = [getattr(args, "codex", None) or os.environ.get("CODEX_BIN", "codex"), "exec", "--json"]
    if model:
        cmd += ["--model", model]
    return cmd + [prompt]


HARNESS_LAUNCHERS = {"grok": launch_grok, "codex": launch_codex}


def launch_cmd(prompt, model, args, key, session=None, resume=False, max_turns=None):
    """`session` is the session id: with resume, `--resume <id>` continues it
    (same id; claude finds it from any cwd), else `--session-id <id>` names a
    new one so it can be resumed later. `max_turns` is data.max_turns."""
    harness = getattr(args, "harness", "claude")
    if harness != "claude":
        return HARNESS_LAUNCHERS[harness](prompt, model, args, key)
    cmd = [args.claude, "-p", prompt,
           "--agent", AGENT,
           "--model", model]
    for d in plugin_dirs(args.plugin_dir):
        cmd += ["--plugin-dir", d]
    if session:
        cmd += ["--resume" if resume else "--session-id", session]
    if max_turns:
        cmd += ["--max-turns", str(max_turns)]
    cmd += ["--allowedTools", ",".join(allowed_tools()),
            "--permission-prompts", "none",
            "--output-format", "stream-json", "--verbose",
            "--name", "graph:" + key]
    if args.max_budget_usd:
        cmd += ["--max-budget-usd", str(args.max_budget_usd)]
    return cmd


class Dispatcher:
    def __init__(self, api, args, out=sys.stdout):
        self.api, self.args, self.out = api, args, out
        self.g = args.graph
        self.workers = {}
        self.attempts = {}
        self.state = args.state_dir
        self.logs = os.path.join(self.state, "logs")
        self.types = None if args.types == "all" else set(args.types.split(","))
        self.peak = 0
        self.blocked = False
        self.salvaged = set()  # node keys already salvaged (or skipped) this session
        self.denied = {}  # node key -> worktree path: denied by the environment, not relaunched this session
        self.limited_until = 0.0  # harness usage limit: no launches before this instant
        self.limit_noted = 0.0
        self.mcp_down = 0
        self.last_skip = {}
        self.drain_said = False
        self.warm = {}  # (repo, model) -> [Session], idle and resumable
        # remediation: node key -> [{error, rejection}] of its failed attempts this
        # session, and the session of the last one (resumed by the next launch)
        self.failures = {}
        self.fail_session = {}
        self.triaged = set()  # node keys triaged (or whose triage could not start) this session
        self.triaged_sig = {}  # failed node key -> its runs' signature when it was triaged (any node type)
        self.retry_sleep = 2.0
        self.lease_at = 0.0
        self.all_nodes = []  # the last pass's node list: triage resolves `existing` prerequisites against it

    def say(self, msg):
        line = "%s %s" % (utcnow().strftime("%H:%M:%S"), msg)
        print(line, file=self.out, flush=True)
        if not self.args.dry_run:
            with open(os.path.join(self.state, "dispatcher.log"), "a") as f:
                f.write(line + "\n")

    def stopping(self):
        return os.path.exists(self.args.stop_file)

    # --- reading the plan
    def candidates(self, nodes):
        """Frontier nodes looking for work, then nodes whose lease lapsed,
        in that order, filtered to the dispatchable types and attempt cap."""
        front = self.api.frontier(self.g)
        ours = set(self.workers)
        out, seen = [], set()
        for n in front:
            if n.get("work_state") not in (None, "looking_for_work"):
                continue
            if lapsed(n):  # the server lists a lapsed run's node as looking_for_work
                n = dict(n, _lapsed=True)
            out.append(n)
            seen.add(n["id"])
        for n in nodes:
            if n["id"] not in seen and n.get("key") not in ours and lapsed(n):
                n = dict(n, _lapsed=True)
                out.append(n)
        keep = []
        for n in out:
            if self.types is not None and n.get("type") not in self.types:
                continue
            if n.get("key") == LEASE_KEY or (n.get("data") or {}).get("dispatcher_lease"):
                continue  # the dispatcher's own lease record, not work
            if (n.get("data") or {}).get("triage_of"):
                continue  # a triage node: launched by the dispatcher that made it, never from the frontier
            if n["key"] in self.denied:
                continue  # environmental: the salvage path, never triage
            if self.attempts.get(n["key"], 0) >= self.args.max_attempts:
                # the task attempts are spent: one triage per node per session
                if (not self.args.no_triage and n["key"] not in self.triaged and not merge_target(n)
                        and len(self.failures.get(n["key"]) or []) >= self.args.max_attempts
                        and self.grace_ok(n)):
                    keep.append(dict(n, _triage=True))
                continue
            keep.append(n)
        keep += self.failed_for_triage(nodes, {k["id"] for k in keep})
        return keep

    def runs_sig(self, n):
        """What a node's runs look like now: (count, newest id). None when unreadable."""
        try:
            runs = self.api.runs(self.g, n["id"])
        except (APIError, AttributeError):
            return None
        last = runs[-1] if runs else {}
        return (len(runs), str(last.get("id") or last.get("run_id") or last.get("status") or ""))

    def failed_for_triage(self, nodes, taken):
        """Failed nodes of a type the dispatcher never launches (ops, gate,
        release, ...), with no live run, not triaged since their runs last
        changed. They never reach the task path, so without this nothing
        recovers them. data.triaged_at + data.triaged_runs persist the mark
        across sessions; self.triaged_sig holds it for this one."""
        out = []
        if self.args.no_triage or self.types is None:
            return out
        for n in nodes:
            key = n.get("key")
            if (n.get("status") != "failed" or n["id"] in taken or n.get("type") in self.types
                    or key in self.workers or key in self.denied or merge_target(n)
                    or (n.get("data") or {}).get("triage_of")):
                continue
            d = n.get("data") or {}
            seen = self.triaged_sig.get(key)
            if seen is None and d.get("triaged_at"):
                seen = d.get("triaged_runs")
                seen = tuple(seen) if isinstance(seen, list) else seen
            if seen is not None:
                sig = self.runs_sig(n)
                if sig is None or sig == seen:
                    continue  # unchanged since the triage (or unreadable): idempotent
            if not self.grace_ok(n):
                continue
            out.append(dict(n, _triage=True, _triage_any=True))
        return out

    def last_run_end(self, n):
        """Epoch seconds the node's newest run ended, or None when unknown."""
        try:
            runs = self.api.runs(self.g, n["id"])
        except (APIError, AttributeError):
            return None
        if not runs:
            return None
        r = runs[-1]
        for k in ("ended_at", "finished_at", "completed_at", "updated_at"):
            if r.get(k):
                try:
                    return parse_ts(r[k]).timestamp()
                except (ValueError, TypeError, AttributeError):
                    return None
        return None

    def grace_ok(self, n):
        """Triage waits --triage-grace seconds after the last run ended: the
        coordinator may still be reporting the node, or retrying it."""
        grace = getattr(self.args, "triage_grace", 0) * 60
        if grace <= 0:
            return True
        end = self.last_run_end(n)
        if end is None:
            return True
        if time.time() - end >= grace:
            return True
        if self.last_skip.get("grace:" + n["key"]) is None:
            self.say("triage %s waits: last run ended under %g min ago" % (n["key"], grace / 60))
            self.last_skip["grace:" + n["key"]] = 1
        return False

    def held_elsewhere(self, nodes):
        held = set()
        ours = set(self.workers)
        for n in nodes:
            if n.get("status") == "running" and n.get("key") not in ours and not lapsed(n):
                held |= resources_of(n)
        for w in self.workers.values():
            held |= w.resources
        return held

    # --- one pass
    def tick(self):
        nodes = self.api.nodes(self.g)
        self.all_nodes = nodes
        cands = self.candidates(nodes)
        # Agents fill the N worker slots; a merge costs no model, so it takes
        # no slot, but holds land:<repo> so one repo lands one PR at a time.
        slots = self.args.workers - sum(1 for w in self.workers.values() if w.kind == "agent")
        held = self.held_elsewhere(nodes)
        agents = [n for n in cands if not merge_target(n)]
        # repo affinity: a ready node whose repo has an idle warm session on
        # its model goes first, so the session's repo knowledge is reused
        agents = affinity_order(agents, self.warm_counts(), lambda n: model_for(n, self.args.model))
        merges = [n for n in cands if merge_target(n)]
        chosen, skipped = select(agents, held, max(slots, 0), self.workers)
        for n in chosen:
            held |= resources_of(n)
        m_chosen, m_skipped = select(merges, held, len(merges), self.workers)
        chosen, skipped = chosen + m_chosen, skipped + m_skipped
        for n, why in skipped:
            if (why != "no free worker slot" or self.args.dry_run) and self.last_skip.get(n["key"]) != why:
                self.say("skip %s: %s" % (n["key"], why))
            self.last_skip[n["key"]] = why
        if self.stopping() and not self.drain_said:
            self.drain_said = True
            self.say("stop file present: draining; %d worker(s) running (%s), no new launches"
                     % (len(self.workers), ", ".join(self.workers) or "-"))
        if self.stopping() or self.blocked:
            if chosen:
                self.say(("blocked" if self.blocked else "stop file present") + ": not launching %s" % ", ".join(n["key"] for n in chosen))
            return nodes, []
        for n in chosen:
            self.launch(n)
        return nodes, chosen

    # --- warm sessions
    def warm_counts(self):
        return {k: len(v) for k, v in self.warm.items() if v}

    def take_warm(self, repo, model):
        """The newest idle session for (repo, model) still inside its life
        cap, or None. Sessions past the cap are retired here, with a line."""
        pool = self.warm.get((repo, model)) or []
        while pool:
            sess = pool.pop()
            ok, why = session_usable(sess, self.args.warm_max_nodes, self.args.warm_max_age * 60)
            if ok:
                return sess
            self.say("retire session %s (%s): %s" % (sess.sid, repo, why))
        return None

    def keep_warm(self, sess):
        ok, why = session_usable(sess, self.args.warm_max_nodes, self.args.warm_max_age * 60)
        if not ok:
            self.say("retire session %s (%s): %s" % (sess.sid, sess.repo, why))
            return
        self.warm.setdefault((sess.repo, sess.model), []).append(sess)

    def launch(self, n, cold=False):
        a = self.args
        mt = merge_target(n)
        tag = " (lease lapsed; re-claim)" if n.get("_lapsed") else ""
        if mt:
            pr, slug = mt
            cwd = os.path.join(a.repo_root, (n.get("data") or {}).get("repo", "")) if a.repo_root else None
            if not cwd or not os.path.isdir(cwd):
                cwd = os.getcwd()
            cmd = [LAND_PR, pr] + (["-R", slug] if slug else []) + ["--timeout", str(a.land_timeout)]
            if a.dry_run:
                self.say("would land %s [merge, no agent]%s: %s (cwd %s)" % (n["key"], tag, " ".join(cmd), cwd))
                return
            self.launch_merge(n, cmd, cwd)
            return
        if n.get("_triage"):
            self.launch_triage(n)
            return
        model = model_for(n, a.model)
        repo = repo_of(n)
        path, branch, note = worktree_for(n, a.repo_root, self.state, dry=a.dry_run)
        failures = self.failures.get(n["key"]) or []
        sess = None
        if failures and not cold and not a.no_warm and not a.dry_run:
            # a remediation launch resumes the failed attempt's own session, so
            # the worker keeps what it learned
            sess = self.fail_session.pop(n["key"], None)
        elif repo and not cold and not a.no_warm and not a.dry_run:
            sess = self.take_warm(repo, model)
        resumed = sess is not None
        if not resumed:
            sess = Session(str(uuid.uuid4()), repo, model)
        turns_cap = node_max_turns(n)
        if failures:
            prompt = remediation_prompt(self.g, n, path, branch, failures)
            tag += " (remediation after %d failed attempt(s))" % len(failures)
        else:
            prompt = worker_prompt(self.g, n, path, branch, previous=sess.last_key if resumed else None)
        cmd = launch_cmd(prompt, model, a, n["key"], session=sess.sid, resume=resumed, max_turns=turns_cap)
        res = ",".join(sorted(resources_of(n))) or "-"
        if a.dry_run:
            self.say("would launch %s [%s, tier %s] model=%s worktree=%s branch=%s (%s) resources=%s%s%s"
                     % (n["key"], n.get("type"), (n.get("data") or {}).get("tier", "-"), model, path,
                        branch or "-", note, res, " max_turns=%d" % turns_cap if turns_cap else "", tag))
            if not getattr(self, "_shown_cmd", False):
                self._shown_cmd = True
                self.say("  cmd: " + " ".join(shlex.quote(c) for c in cmd[:2]) + " <prompt> "
                         + " ".join(shlex.quote(c) for c in cmd[3:]))
            return
        self.attempts[n["key"]] = self.attempts.get(n["key"], 0) + 1
        log = os.path.join(self.logs, "%s.%d.jsonl" % (n["key"], self.attempts[n["key"]]))
        w = Worker(n, log)
        # JEV_HOOKS_HEADLESS tells jev-hooks the launcher is headless, so it allows the
        # graph/<key> push; set for the worker only, never for the dispatcher itself.
        env = dict(os.environ, GRAPH_ID=self.g, JEV_HOOKS_HEADLESS="1")
        w.path = path
        with open(log, "w") as f:
            w.proc = subprocess.Popen(cmd, cwd=path, stdin=subprocess.DEVNULL, stdout=f,
                                      stderr=subprocess.STDOUT, env=env, start_new_session=True)
        w.model, w.turns = model, 0
        w.session, w.resumed = sess, resumed
        # claude enforces data.max_turns itself; the stream count is the backstop
        w.max_turns = max(a.max_turns, turns_cap or 0)
        prev = sess.last_key
        sess.nodes += 1
        sess.last_key = n["key"]
        self.workers[n["key"]] = w
        self.peak = max(self.peak, len(self.workers))
        if resumed:
            mode = "mode=resume session=%s (node %d of max %d, %dm old, after %s)" % (
                sess.sid, sess.nodes, a.warm_max_nodes, (time.time() - sess.born) // 60, prev)
        else:
            mode = "mode=cold session=%s" % sess.sid
        self.say("launch %s pid=%d model=%s %s cwd=%s (%s) log=%s%s"
                 % (n["key"], w.proc.pid, model, mode, path, note, log, tag))

    # --- triage: a node whose task attempts all failed
    def launch_triage(self, n):
        """Create a triage node for `n` and launch a deep-tier worker on it.
        The worker decides (revise / prerequisite / gate) and reports the
        TRIAGE node with data.triage; finish_triage makes the graph writes.
        At most once per node per session, whether or not it starts."""
        a, key = self.args, n["key"]
        fresh = None
        try:
            fresh = self.api.node(self.g, n["id"]) if hasattr(self.api, "node") else None
        except APIError:
            fresh = None
        if fresh and fresh.get("status") in ("done", "running", "verifying", "cancelled"):
            self.say("TRIAGE-SKIPPED %s: no longer failed (status %s)" % (key, fresh.get("status")))
            self.last_skip.pop("grace:" + key, None)
            return
        self.triaged.add(key)
        if n.get("_triage_any"):
            self.triaged_sig[key] = self.runs_sig(n) or ()
        if a.dry_run:
            self.say("would triage %s (%s) with %s after %d failed attempt(s)"
                     % (key, n.get("type"), a.triage_model, len(self.failures.get(key) or [])))
            return
        history = {"failures": self.failures.get(key) or []}
        for what, fn in (("runs", "runs"), ("observations", "observations")):
            try:
                history[what] = getattr(self.api, fn)(self.g, n["id"])[-5:]
            except (APIError, AttributeError) as e:
                history[what] = "unavailable: %s" % e
        tkey = "triage-%s-%s" % (key, uuid.uuid4().hex[:6])
        try:
            tnode = self.api.create_node(self.g, {
                "key": tkey, "type": "chore", "title": "triage %s: why it failed, and what it needs" % key,
                "description": "Triage of `%s` (type %s, failed): decide "
                               "revise / prerequisite / gate and report data.triage. Created by graph-dispatch."
                               % (key, n.get("type")),
                "data": {"triage_of": n["id"], "triage_of_key": key, "tier": "deep", "created_by": "graph-dispatch",
                         "acceptance": ["data.triage names exactly one of revise / prerequisite / gate, with the "
                                        "reason drawn from the failed runs' errors and verdicts"]}})
        except APIError as e:
            self.say("TRIAGE-SKIPPED %s: could not create the triage node: %s" % (key, e))
            return
        tnode = dict(tnode or {}, key=(tnode or {}).get("key") or tkey)
        if not tnode.get("id"):
            self.say("TRIAGE-SKIPPED %s: the triage node came back with no id" % key)
            return
        path = os.path.join(self.state, "work", tkey)
        os.makedirs(path, exist_ok=True)
        sess = Session(str(uuid.uuid4()), None, a.triage_model)
        cmd = launch_cmd(triage_prompt(self.g, tnode, n, history), a.triage_model, a, tkey, session=sess.sid)
        log = os.path.join(self.logs, "%s.triage.jsonl" % key)
        w = Worker(tnode, log)
        w.triage_of, w.path, w.model, w.turns, w.session, w.resumed = n, path, a.triage_model, 0, sess, False
        w.triage_any = bool(n.get("_triage_any"))
        w.max_turns = a.max_turns
        env = dict(os.environ, GRAPH_ID=self.g, JEV_HOOKS_HEADLESS="1")
        with open(log, "w") as f:
            w.proc = subprocess.Popen(cmd, cwd=path, stdin=subprocess.DEVNULL, stdout=f,
                                      stderr=subprocess.STDOUT, env=env, start_new_session=True)
        self.workers[tkey] = w
        self.peak = max(self.peak, len(self.workers))
        self.say("TRIAGE %s: %d failed attempt(s); triage node %s, pid=%d model=%s log=%s"
                 % (key, len(history["failures"]), tkey, w.proc.pid, a.triage_model, log))

    def finish_triage(self, w, s):
        """Apply a triage worker's decision. Nothing is written unless it
        reported its own triage node succeeded with a valid data.triage."""
        failed, tkey = w.triage_of, w.key
        key = failed["key"]
        if s["report_node"] and s["report_node"] != w.node["id"]:
            self.say("TRIAGE-VIOLATION %s: the triage worker reported node %s, not its triage node %s; "
                     "nothing applied" % (key, s["report_node"], tkey))
            return None
        if not s["reported"] or s["report_status"] != "succeeded":
            self.say("TRIAGE-NONE %s: triage %s %s; left for a person" % (
                key, tkey, "reported %s: %s" % (s["report_status"], clip(s["report_error"] or "-", 200))
                if s["reported"] else "did not report"))
            return None
        t, why = triage_decision(s["report_data"])
        if t is None:
            self.say("TRIAGE-NONE %s: %s; left for a person" % (key, why))
            return None
        try:
            writes = self.apply_triage(failed, tkey, t)
        except APIError as e:
            self.say("TRIAGE-WRITE-FAILED %s (%s): %s" % (key, t["action"], e))
            return None
        self.say("TRIAGE %s -> %s: %s (%s)" % (key, t["action"], "; ".join(writes), clip(t["reason"], 200)))
        if getattr(w, "triage_any", False):
            self.mark_triaged(failed, tkey)
        return writes

    def mark_triaged(self, failed, tkey):
        """data.triaged_at + the runs signature: not triaged again until the runs change."""
        sig = self.triaged_sig.get(failed["key"]) or ()
        try:
            self.api.patch_node(self.g, failed["id"], {"merge_data": True, "data": {
                "triaged_at": utcnow().isoformat(), "triaged_in": tkey, "triaged_runs": list(sig)}})
        except APIError as e:
            self.say("TRIAGE-MARK-FAILED %s: %s (in-session mark still holds)" % (failed["key"], e))

    def apply_triage(self, failed, tkey, t):
        """The graph writes of one decision; returns them as log strings.
        revise: the failed node's description/acceptance/brief, with
        data.revised_by=triage. prerequisite: each new node plus a `requires`
        edge from the failed node to it. gate: one gate node naming the
        decision plus the `requires` edge that holds the failed node behind it,
        and nothing else."""
        g, act, reason = self.g, t["action"], t["reason"]
        fdata = failed.get("data") or {}
        if act == "revise":
            data = {"revised_by": "triage", "revised_reason": reason, "revised_in": tkey}
            for k in ("acceptance", "brief"):
                if t.get(k):
                    data[k] = t[k]
            body = {"data": data, "merge_data": True}
            if t.get("description"):
                body["description"] = t["description"]
            if t.get("type"):
                body["type"] = t["type"]  # e.g. a merged-and-applied ops node whose remainder is verification -> task
            self.api.patch_node(g, failed["id"], body)
            return ["patched %s (%s)" % (failed["key"], ", ".join(sorted(set(body) - {"merge_data"} | set(data))))]
        specs = t["nodes"] if act == "prerequisite" else [{
            "key": t.get("gate_key") or "gate-" + failed["key"], "type": "gate", "title": t["decision"],
            "description": "%s\n\nWhy (triage %s): %s" % (t["decision"], tkey, reason),
            "data": {"decision": t["decision"]}, "existing": bool(t.get("gate_key"))}]
        out = []
        for spec in specs:
            if spec.get("existing"):
                # point at a node that already exists (the thing the failed node is waiting on)
                ex = next((x for x in self.all_nodes if spec["key"] in (x.get("key"), x.get("id"))), None)
                if not ex:
                    raise APIError("triage", "existing node %s not found" % spec["key"])
                self.api.create_edge(g, {"from_node_id": failed["id"], "to_node_id": ex["id"], "type": "requires"})
                out.append("requires edge %s -> %s (existing)" % (failed["key"], ex["key"]))
                continue
            data = dict(spec.get("data") or {}, created_by="triage", triage_of_key=failed["key"], triage_reason=reason)
            for k in ("acceptance", "brief"):
                if spec.get(k):
                    data[k] = spec[k]
            if act == "prerequisite" and fdata.get("repo") and "repo" not in data:
                data["repo"] = fdata["repo"]
            created = self.api.create_node(g, {"key": spec["key"], "title": spec["title"],
                                               "type": spec.get("type") or ("gate" if act == "gate" else "task"),
                                               "description": spec.get("description") or "", "data": data})
            nid = (created or {}).get("id")
            if not nid:
                raise APIError("triage", "created node %s came back with no id" % spec["key"])
            self.api.create_edge(g, {"from_node_id": failed["id"], "to_node_id": nid, "type": "requires"})
            out.append("created %s %s + requires edge %s -> %s"
                       % ("gate" if act == "gate" else "node", spec["key"], failed["key"], spec["key"]))
        return out

    def launch_merge(self, n, cmd, cwd):
        self.attempts[n["key"]] = self.attempts.get(n["key"], 0) + 1
        try:
            card = self.api.claim(self.g, n["id"], "graph-dispatch")
        except APIError as e:
            self.say("claim %s refused: %s" % (n["key"], e))
            return
        log = os.path.join(self.logs, "%s.%d.log" % (n["key"], self.attempts[n["key"]]))
        w = Worker(n, log)
        w.kind, w.run_id, w.cmd, w.last_hb = "merge", card["run_id"], cmd, time.time()
        with open(log, "w") as f:
            w.proc = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=f,
                                      stderr=subprocess.STDOUT, start_new_session=True)
        self.workers[n["key"]] = w
        self.peak = max(self.peak, len(self.workers))
        self.say("land %s pid=%d run=%s: %s log=%s" % (n["key"], w.proc.pid, w.run_id, " ".join(cmd), log))

    # --- supervision
    def reap(self):
        for key, w in list(self.workers.items()):
            if w.kind == "salvage":
                if not w.alive():
                    del self.workers[key]
                    self.finish_salvage(w)
                continue
            if w.kind == "merge":
                if w.alive() and time.time() - w.last_hb > self.args.heartbeat:
                    try:
                        st = self.api.heartbeat(self.g, w.node["id"], w.run_id).get("state")
                        w.last_hb = time.time()
                        if st and st != "ok":
                            self.say("heartbeat %s: %s" % (key, st))
                    except APIError as e:
                        self.say("heartbeat %s failed: %s" % (key, e))
                if not w.alive():
                    self.finish_merge(w)
                    del self.workers[key]
                continue
            salvage = None
            w.turns = count_turns(w.log_path, getattr(self.args, "harness", "claude"))
            cap = getattr(w, "max_turns", self.args.max_turns)
            if w.alive() and w.turns > cap:
                self.say("turn cap: %s at %d turns > %d, stopping it" % (key, w.turns, cap))
                os.killpg(w.proc.pid, signal.SIGTERM)
                w.proc.wait(timeout=30)
            if not w.alive():
                s = summarize(w.log_path, getattr(self.args, "harness", "claude"))
                sess = getattr(w, "session", None)
                limit_text = harness_limit_text(s)
                if limit_text:
                    # the harness, not the node: refund the attempt, leave the
                    # run to lapse (a failed run would read as the node's
                    # fault), and hold every launch until the reset
                    del self.workers[key]
                    self.attempts[key] = max(0, self.attempts.get(key, 0) - 1)
                    until = limit_reset_at(limit_text) or (time.time() + self.args.limit_backoff)
                    self.limited_until = max(self.limited_until, until)
                    self.say("HARNESS-LIMITED %s: %s; no attempt spent; %s until %s"
                             % (key, clip(limit_text, 160), "waiting" if self.args.on_limit == "wait" else "exiting",
                                time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(until))))
                    continue
                if sess is not None and getattr(w, "resumed", False) and not s["started"]:
                    # the resume never started (session gone, unreadable, ...):
                    # not the node's fault, so no attempt is spent; drop the
                    # session and start this node cold, now
                    del self.workers[key]
                    self.attempts[key] -= 1
                    self.say("resume failed for %s (session %s): %s; falling back to a cold start"
                             % (key, sess.sid, s["error_text"] or "result=%s exit=%s" % (s["result"], w.proc.returncode)))
                    if not (self.stopping() or self.blocked):
                        self.launch(w.node, cold=True)
                    continue
                u = s["usage"]
                cost = s["cost"]
                if sess is not None and isinstance(cost, (int, float)):
                    # a resumed session's total_cost_usd is the session's running
                    # total: log this node's share
                    if getattr(w, "resumed", False) and isinstance(sess.cost, (int, float)):
                        cost = round(cost - sess.cost, 6)
                    sess.cost = s["cost"]
                self.say("done %s exit=%s turns=%s result=%s denials=%d run=%s reported=%s cost=%s "
                         "session=%s %s cache_read=%s cache_creation=%s output=%s"
                         % (key, w.proc.returncode, s["turns"], s["result"], s["denials"], s["run_id"] or "-",
                            s["reported"], cost, (sess.sid if sess else "-"),
                            "resumed" if getattr(w, "resumed", False) else "cold",
                            u.get("cache_read_input_tokens", "-"), u.get("cache_creation_input_tokens", "-"),
                            u.get("output_tokens", "-")))
                outcome = failed_outcome(s, w.proc.returncode)
                if sess is not None and sess.repo and not self.args.no_warm:
                    if s["reported"] and s["result"] == "success" and w.proc.returncode == 0 and outcome is None:
                        if s["session_id"] and s["session_id"] != sess.sid:
                            sess.sid = s["session_id"]  # claude said otherwise: trust the stream
                        self.keep_warm(sess)
                    else:
                        self.say("session %s not kept warm: %s did not finish cleanly" % (sess.sid, key))
                if s["run_id"] and not s["reported"]:
                    self.fail_orphan(w, s)
                down = {k: v for k, v in s["mcp"].items() if k.startswith("plugin:enforcer") and v != "connected"}
                if down and not s["run_id"]:
                    # never reached the graph: the MCP server was not connected
                    # (a needs-auth flake). Not the node's fault, so it does not
                    # spend an attempt, but three in a row is a real outage.
                    self.attempts[key] -= 1
                    self.mcp_down += 1
                    self.say("mcp %s for %s; retrying later (%d in a row)"
                             % (",".join("%s=%s" % kv for kv in down.items()), key, self.mcp_down))
                    if self.mcp_down >= 3 and not self.blocked:
                        self.blocked = True
                        self.say("BLOCKED: the enforcer MCP server was not connected for 3 workers in a row; "
                                 "run /enforcer:login, then restart. Launching no more workers (drain).")
                elif s["mcp"]:
                    self.mcp_down = 0
                graph_denied = [t for t in s["denied_tools"] if GRAPH_TOOL_RE.search(t)]
                if graph_denied and not self.blocked:
                    self.blocked = True
                    self.say("BLOCKED: %s denied in a headless worker. The MCP server marks the graph work-loop "
                             "tools requiresUserInteraction, which claude -p refuses whatever --allowedTools says; "
                             "launching no more workers (drain). See README 'Headless workers'."
                             % ", ".join(graph_denied))
                other = [t for t in s["denied_tools"] if t not in graph_denied]
                kind, rec = denial_class(s)
                if kind is None:
                    # no decision record (an older governor): the text match, as before
                    is_denied = bool(other or DENIAL_TEXT_RE.search(s["result_text"] or ""))
                    why = ", ".join(other) or clip(s["result_text"] or "", 120)
                else:
                    is_denied = kind in ("salvage", "denied")
                    why = "%s (%s)" % (rec["code"], rec.get("summary") or rec.get("tool") or "-")
                if kind in ("triage", "remediation") and not graph_denied and not getattr(w, "triage_of", None):
                    # the code decides: never salvaged. destructive_* spends the
                    # attempts so the node goes to triage; graph_run_not_open is a
                    # remediation launch with the code in the prompt
                    outcome = outcome or {"error": "", "rejection": None}
                    outcome = dict(outcome, error=clip("governor denied (%s): %s; %s" % (
                        rec["code"], rec.get("summary") or "-", outcome.get("error") or ""), 1500))
                    if kind == "triage":
                        self.attempts[key] = max(self.attempts.get(key, 0), self.args.max_attempts)
                        self.failures.setdefault(key, []).extend(
                            [outcome] * max(1, self.args.max_attempts - len(self.failures.get(key) or [])))
                        outcome = None  # recorded above; not a further attempt
                        self.say("TRIAGE-ON-CODE %s: %s; never salvaged" % (key, why))
                elif is_denied and not graph_denied and key not in self.denied:
                    self.denied[key] = getattr(w, "path", None) or "-"
                    self.say("DENIED %s: %s; not relaunching it this session. Worktree: %s "
                             "(a person can land it)" % (key, why, self.denied[key]))
                    salvage = (w, s) if kind in (None, "salvage") else None
                elif is_denied and not graph_denied and key in self.salvaged:
                    self.say("SALVAGE-SKIPPED %s: denied again after a salvage" % key)
                if getattr(w, "triage_of", None) is not None:
                    self.finish_triage(w, s)
                elif outcome and key not in self.denied and not graph_denied and not (down and not s["run_id"]):
                    # a task failure (not an environmental denial, not an MCP
                    # flake): the next launch is a remediation launch that
                    # resumes this session; past the attempt cap, a triage
                    self.failures.setdefault(key, []).append(outcome)
                    if sess is not None and s["started"]:
                        if s["session_id"] and s["session_id"] != sess.sid:
                            sess.sid = s["session_id"]
                        self.fail_session[key] = sess
                    n_failed = len(self.failures[key])
                    self.say("FAILED %s (attempt %d of %d this session): %s; next: %s"
                             % (key, n_failed, self.args.max_attempts, clip(outcome["error"], 200),
                                "remediation launch" if self.attempts.get(key, 0) < self.args.max_attempts
                                else ("left for a person (--no-triage)" if self.args.no_triage else "triage")))
                del self.workers[key]
                if salvage and not self.args.no_salvage:
                    self.salvage(*salvage)

    # --- salvage a denied push / PR
    def _sh(self, cmd, cwd, timeout=300):
        """Run a command; a gh/git network failure is retried with backoff (never raises)."""
        rc, out = 127, ""
        for i in range(3):
            try:
                r = subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
                rc, out = r.returncode, (r.stdout + r.stderr).strip()
            except (OSError, subprocess.TimeoutExpired) as e:
                rc, out = 127, str(e)
            if rc == 0 or not TRANSIENT_RE.search(out) or i == 2:
                break
            time.sleep(self.retry_sleep * (2 ** i))
        return rc, out

    def salvage(self, w, s):
        """Finish the mechanical part of a push/PR-denied worker: push, open the
        PR, then start land-pr as a tracked child (kind "salvage") and return
        True; finish_salvage resumes its session to report when land-pr exits.
        Asynchronous: the loop keeps scheduling other nodes while CI runs."""
        key, path = w.node["key"], getattr(w, "path", None)

        def skip(why):
            self.say("SALVAGE-SKIPPED %s: %s" % (key, why))
            return False
        if key in self.salvaged:
            return skip("already salvaged once this session")
        self.salvaged.add(key)
        if DELIVER_SKILL not in (s.get("card_skills") or []):
            return skip("the node's skills do not include %s; left for triage" % DELIVER_SKILL)
        cmds = " ".join(str((d or {}).get("tool_input", {}).get("command", "")) if isinstance(d, dict) else ""
                        for d in s.get("denied_inputs", []))
        others = [t for t in s["denied_tools"] if t != "Bash"]
        if denial_class(s)[0] == "salvage":
            pass  # the governor said so by code: no text to match
        elif denial_class(s)[0] is not None or others or not (PUSH_DENIAL_RE.search(cmds) or (not s["denied_tools"] and PUSH_DENIAL_RE.search(s["result_text"] or ""))):
            return skip("not a push or PR denial")
        if not path or path == "-" or not os.path.isdir(path):
            return skip("no worktree")
        branch = "graph/" + key
        rc, cur = self._sh(["git", "rev-parse", "--abbrev-ref", "HEAD"], path)
        if rc or cur != branch:
            return skip("branch is %s, not %s" % (cur or "unknown", branch))
        rc, st = self._sh(["git", "status", "--porcelain"], path)
        if rc or st:
            return skip("worktree is dirty or unreadable")
        base = None
        dbase = ((w.node.get("data") or {}).get("base") or "").strip()
        if dbase:  # the node's own base, as the worktree step honours it
            dbase = dbase if dbase.startswith("origin/") else "origin/" + dbase
            if self._sh(["git", "rev-parse", "--verify", "-q", dbase], path)[0] == 0:
                base = dbase
            else:
                return skip("data.base %s not found on origin" % dbase)
        for ref in (() if base else ("origin/HEAD", "origin/main", "origin/master")):
            if self._sh(["git", "rev-parse", "--verify", "-q", ref], path)[0] == 0:
                base = ref
                break
        if not base:
            return skip("no base branch found")
        rc, n = self._sh(["git", "rev-list", "--count", base + "..HEAD"], path)
        if rc or not n.isdigit() or int(n) < 1:
            return skip("branch has no commits ahead of %s" % base)
        rc, out = self._sh(["git", "push", "-u", "origin", branch], path)
        if rc:
            return skip("push failed: %s" % clip(out, 200))
        body = (s["result_text"] or "(no final report)") + "\n\n" + ATTRIBUTION
        if base == "origin/HEAD":
            rc, h = self._sh(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], path)
            base = h if rc == 0 and h else "origin/main"
        pr_base = base[len("origin/"):] if base.startswith("origin/") else base
        rc, out = self._sh(["gh", "pr", "create", "--base", pr_base, "--head", branch, "--title", w.node.get("title") or key,
                            "--body", body], path)
        m = re.search(r"/pull/(\d+)", out) if rc == 0 else None
        if not m:
            return skip("gh pr create failed: %s" % clip(out, 200))
        pr = m.group(1)
        self.say("salvage %s: pushed %s, opened PR #%s, landing" % (key, branch, pr))
        # land-pr waits for CI, possibly for an hour: run it as a tracked child
        # and keep scheduling; reap() calls finish_salvage when it exits
        cmd = [LAND_PR, pr, "--timeout", str(self.args.land_timeout)]
        log = os.path.join(self.logs, "%s.%d.salvage-land.log" % (key, self.attempts.get(key, 1)))
        sw = Worker(w.node, log)
        sw.kind, sw.cmd, sw.path, sw.pr, sw.orig = "salvage", cmd, path, pr, (w, s)
        try:
            with open(log, "w") as f:
                sw.proc = subprocess.Popen(cmd, cwd=path, stdin=subprocess.DEVNULL, stdout=f,
                                           stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as e:
            return skip("PR #%s: could not start land-pr: %s" % (pr, e))
        self.workers[key] = sw  # counts against the node, not against the worker slots
        self.say("salvage %s: PR #%s landing in the background pid=%d log=%s" % (key, pr, sw.proc.pid, log))
        return True

    def finish_salvage(self, sw):
        """land-pr of a salvage exited: resume the worker's session to report.
        Returns True when the worker was resumed."""
        key, pr, path = sw.key, sw.pr, sw.path
        w, s = sw.orig
        rc = sw.proc.returncode
        with open(sw.log_path, errors="replace") as f:
            out = f.read().strip()

        def skip(why):
            self.say("SALVAGE-SKIPPED %s: %s" % (key, why))
            return False
        if rc:
            return skip("PR #%s: land-pr exited %d (%s): %s" % (pr, rc, LAND_CODES.get(rc, "unknown"), clip(out, 200)))
        sess = getattr(w, "session", None)
        if sess is None:
            return skip("PR #%s landed but the worker has no session to resume" % pr)
        prompt = ("Your branch is pushed as PR #%s and land-pr exited %d with %s; claim the node again, "
                  "run the deciding gate on the merged tree as your last commands, and report."
                  % (pr, rc, clip(out, 500)))
        a = self.args
        cmd = launch_cmd(prompt, w.model, a, key, session=sess.sid, resume=True, max_turns=getattr(w, "max_turns", None))
        log = os.path.join(self.logs, "%s.%d.salvage.jsonl" % (key, self.attempts.get(key, 1)))
        nw = Worker(w.node, log)
        env = dict(os.environ, GRAPH_ID=self.g, JEV_HOOKS_HEADLESS="1")
        with open(log, "w") as f:
            nw.proc = subprocess.Popen(cmd, cwd=path, stdin=subprocess.DEVNULL, stdout=f,
                                       stderr=subprocess.STDOUT, env=env, start_new_session=True)
        nw.path, nw.model, nw.turns, nw.session, nw.resumed = path, w.model, 0, sess, True
        nw.max_turns = getattr(w, "max_turns", a.max_turns)
        self.workers[key] = nw
        self.say("salvage %s: PR #%s landed (land-pr exit %d); resumed session %s to report, log=%s"
                 % (key, pr, rc, sess.sid, log))
        return True

    def finish_merge(self, w):
        rc = w.proc.returncode
        with open(w.log_path, errors="replace") as f:
            out = f.read()
        ev = {"kind": "command", "cmd": " ".join(w.cmd), "exit": rc, "output": clip(out)}
        ok = rc == 0
        body = {"status": "succeeded" if ok else "failed", "evidence": [ev],
                "data": {"report": "1. %s: land-pr.sh exited %d (%s). Run by graph-dispatch with no agent."
                         % ("MET" if ok else "NOT MET", rc, LAND_CODES.get(rc, "unknown")),
                         "runner": "graph-dispatch"}}
        if not ok:
            body["error"] = "land-pr.sh exit %d (%s): %s" % (rc, LAND_CODES.get(rc, "unknown"), out.strip()[-500:])
        try:
            self.api.complete(self.g, w.node["id"], w.run_id, body)
            self.say("land %s exit=%d -> run %s %s" % (w.key, rc, w.run_id, body["status"]))
        except APIError as e:
            self.say("complete %s failed: %s" % (w.key, e))

    def fail_orphan(self, w, s):
        """A worker that claimed and exited without reporting (crash, turn cap)
        would hold the node until its lease lapses; fail the run so it is
        claimable now and the next attempt knows why."""
        body = {"status": "failed", "error": "graph-dispatch: worker exited (code %s, %s turns) without reporting; "
                "log %s" % (w.proc.returncode, s["turns"], w.log_path),
                "data": {"runner": "graph-dispatch"}}
        try:
            self.api.complete(self.g, w.node["id"], s["run_id"], body)
            self.say("failed orphan run %s of %s" % (s["run_id"], w.key))
        except APIError as e:
            self.say("could not fail orphan run of %s: %s" % (w.key, e))

    # --- the dispatcher lease: one dispatcher per graph
    def lease_data(self):
        until = utcnow() + dt.timedelta(seconds=LEASE_TTL)
        return {"dispatcher": {"owner": "graph-dispatch", "host": socket.gethostname(), "pid": os.getpid(),
                               "until": until.isoformat()}}

    def acquire_lease(self, nodes=None):
        """True when this dispatcher holds the lease (or --takeover took it).
        The lease is data.dispatcher on a `dispatcher-lease` node of the graph."""
        nodes = self.api.nodes(self.g) if nodes is None else nodes
        cur = next((n for n in nodes if n.get("key") == LEASE_KEY), None)
        held = ((cur or {}).get("data") or {}).get("dispatcher")
        if held and held.get("pid") != os.getpid():
            try:
                live = parse_ts(held.get("until")) > utcnow()
            except (ValueError, TypeError, AttributeError):
                live = False
            if live and not self.args.takeover:
                self.say("another graph-dispatch holds graph %s (host %s pid %s, lease until %s); "
                         "exiting. Use --takeover to replace it." % (
                             self.g, held.get("host"), held.get("pid"), held.get("until")))
                return False
            if live:
                self.say("TAKEOVER: replacing the dispatcher on %s pid %s" % (held.get("host"), held.get("pid")))
        self.write_lease(cur)
        return True

    def write_lease(self, cur):
        data = self.lease_data()
        if cur is None:
            self.api.create_node(self.g, {
                "key": LEASE_KEY, "type": "ops", "status": "done", "title": "graph-dispatch lease",
                "description": "Held by the running graph-dispatch for this graph; renewed each pass. Not work.",
                "data": dict(data, dispatcher_lease=True)})
        else:
            self.api.patch_node(self.g, cur["id"], {"data": dict(cur.get("data") or {}, **data)})

    def renew_lease(self):
        if self.args.no_lease:
            return True
        nodes = self.api.nodes(self.g)
        cur = next((n for n in nodes if n.get("key") == LEASE_KEY), None)
        held = ((cur or {}).get("data") or {}).get("dispatcher") or {}
        if held and held.get("pid") != os.getpid() and held.get("host") != socket.gethostname():
            self.say("lease lost to %s pid %s; exiting" % (held.get("host"), held.get("pid")))
            return False
        if held and held.get("pid") != os.getpid():
            self.say("lease lost to pid %s; exiting" % held.get("pid"))
            return False
        self.write_lease(cur)
        return True

    def release_lease(self):
        if self.args.no_lease or self.args.dry_run:
            return
        try:
            nodes = self.api.nodes(self.g)
            cur = next((n for n in nodes if n.get("key") == LEASE_KEY), None)
            if cur and ((cur.get("data") or {}).get("dispatcher") or {}).get("pid") == os.getpid():
                self.api.patch_node(self.g, cur["id"], {"data": dict(cur.get("data") or {}, dispatcher=None)})
        except APIError:
            pass

    def write_pids(self):
        """Process control by recorded pids, never by pgrep patterns."""
        try:
            pids = {"dispatcher": os.getpid(), "workers": {k: w.proc.pid for k, w in self.workers.items()
                                                           if getattr(w, "proc", None)}}
            with open(os.path.join(self.state, "pids.json"), "w") as f:
                json.dump(pids, f)
        except OSError:
            pass

    def run(self):
        a = self.args
        if not a.dry_run and not a.no_lease:
            try:
                if not self.acquire_lease():
                    return 3
            except APIError as e:
                self.say("could not take the dispatcher lease: %s" % e)
                return 1
            try:
                return self.loop()
            finally:
                self.release_lease()
        return self.loop()

    def loop(self):
        a = self.args
        if a.dry_run:
            self.say("dry run on graph %s, %d worker slot(s); nothing is launched" % (self.g, a.workers))
            self.tick()
            return 0
        os.makedirs(self.logs, exist_ok=True)
        self.say("dispatching graph %s with %d workers; stop file %s" % (self.g, a.workers, a.stop_file))
        idle = 0
        while True:
            if self.limited_until > time.time():
                self.reap()
                if self.args.on_limit == "exit" and not self.workers:
                    self.say("harness usage limit: exiting 4; resume after %s"
                             % time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(self.limited_until)))
                    return 4
                if time.time() - self.limit_noted > 600:
                    self.say("harness usage limit: holding every launch until %s (%d running)"
                             % (time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(self.limited_until)), len(self.workers)))
                    self.limit_noted = time.time()
                if self.stopping() and not self.workers:
                    self.say("drained while limited; exiting (peak %d)" % self.peak)
                    return 0
                time.sleep(min(max(a.interval, 1.0), max(self.limited_until - time.time(), 0.0) + 0.01, 300))
                continue
            try:
                self.reap()
                if self.limited_until > time.time():
                    continue  # a worker just reported a usage limit: hold, do not tick
                if time.time() - self.lease_at > LEASE_TTL / 3:
                    if not self.renew_lease():
                        return 3
                    self.lease_at = time.time()
                self.write_pids()
                nodes, launched = self.tick()
            except APIError as e:
                self.say("API error (pass skipped, retrying): %s" % e)
                if e.status in (401, 403, "auth"):
                    return 1
                time.sleep(a.interval)
                continue
            if (self.stopping() or self.blocked) and not self.workers:
                if self.blocked and not self.stopping():
                    self.say("drained after BLOCKED; exiting 2 (peak %d)" % self.peak)
                    return 2
                self.say("drained: stop file present and no worker running; exiting (peak %d)" % self.peak)
                return 0
            busy = any(n.get("status") == "running" and not lapsed(n) for n in nodes)
            if not self.workers and not launched and not busy:
                idle += 1
                if idle >= 2:
                    self.say("nothing runnable or running; exiting (peak %d concurrent)" % self.peak)
                    return 0
            else:
                idle = 0
            time.sleep(a.interval)


LAND_CODES = {0: "merged", 2: "CI failed", 3: "conflict with the base", 4: "timed out", 5: "usage or gh error"}

# A harness usage limit is the HARNESS's state, not the node's: the worker
# exits at its first turn with a message like
#   "You've hit your weekly limit \u00b7 resets Oct 7, 8pm (America/New_York)"
# Before 1.0.0-rc.2 that counted as a failed attempt, the retry hit the same
# wall a second later, the node went to triage and the dispatcher exited with
# "nothing runnable" (2026-10-05, hook-adapter-grok). Now: no attempt is spent,
# the run is left to lapse (not failed), and the dispatcher waits for the reset.
LIMIT_RE = re.compile(r"hit your (?:weekly|daily|monthly|session|usage) limit|usage limit (?:reached|exceeded)|"
                      r"rate[ -]?limit(?:ed|s)?\b|too many requests|out of (?:credits|quota)", re.I)
RESET_RE = re.compile(r"resets?\s+(?:at\s+|on\s+)?(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+(\d{1,2}),?"
                      r"\s+(\d{1,2})(?::(\d{2}))?\s*(am|pm)?(?:\s*\(([A-Za-z_]+/[A-Za-z_+\-]+)\))?", re.I)
MONTHS = {m: i for i, m in enumerate(["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"], 1)}


def harness_limit_text(s):
    """The limit message when a worker's result or stderr says the harness is
    out of quota, else None."""
    for t in (s.get("result_text"), s.get("error_text")):
        if t and LIMIT_RE.search(t):
            return t
    return None


def limit_reset_at(text, now=None):
    """Epoch seconds of the reset named in a limit message ("resets Oct 7, 8pm
    (America/New_York)"), or None when the message names no time. The year is
    the current one, or the next when that instant is already past."""
    m = RESET_RE.search(text or "")
    if not m:
        return None
    import datetime as _dt
    try:
        from zoneinfo import ZoneInfo
        tz = ZoneInfo(m.group(6)) if m.group(6) else None
    except Exception:
        tz = None
    hour = int(m.group(3)) % 12 + (12 if (m.group(5) or "").lower() == "pm" else 0)
    now_ts = time.time() if now is None else now
    base = _dt.datetime.fromtimestamp(now_ts, tz)
    try:
        when = base.replace(month=MONTHS[m.group(1).lower()[:3]], day=int(m.group(2)), hour=hour,
                            minute=int(m.group(4) or 0), second=0, microsecond=0)
    except ValueError:
        return None
    if when.timestamp() < now_ts:
        when = when.replace(year=when.year + 1)
    return when.timestamp()


def grok_events(path):
    """`grok -p --output-format json` prints one JSON object (the final result).
    Yield the Claude-shaped events summarize reads: init, one assistant turn, result."""
    try:
        with open(path, errors="replace") as f:
            o = json.loads(f.read())
    except (OSError, ValueError):
        return
    if not isinstance(o, dict):
        return
    sid = o.get("sessionId")
    yield {"type": "system", "subtype": "init", "session_id": sid, "message": {}}
    n = o.get("num_turns") or 0
    for _ in range(int(n) if isinstance(n, (int, float)) else 0):
        yield {"type": "assistant", "message": {"content": []}}
    ok = o.get("stopReason") == "end_turn"
    yield {"type": "result", "subtype": "success" if ok else "error_" + str(o.get("stopReason")),
           "result": o.get("text"), "usage": o.get("usage"), "num_turns": n, "session_id": sid,
           "total_cost_usd": o.get("total_cost_usd"), "message": {}}


def codex_events(path):
    raise NotImplementedError("codex stream parser: no fixture (no real `codex exec --json` sample "
                              "is recorded); refusing to guess the schema")


HARNESS_PARSERS = {"grok": grok_events, "codex": codex_events}


def _events(path, harness="claude"):
    if harness != "claude":
        yield from HARNESS_PARSERS[harness](path)
        return
    try:
        with open(path) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if isinstance(e, dict):
                    if not isinstance(e.get("message"), dict):
                        e["message"] = {}
                    yield e
    except OSError:
        return


def count_turns(path, harness="claude"):
    return sum(1 for e in _events(path, harness) if e.get("type") == "assistant")


DECISION_PREFIX = "enforcer-governor:decision "


def decision_records(text):
    """The governor's decision records in `text`: each `enforcer-governor:decision
    {json}` line (the hook's stderr line and the first line of a permission
    reason), parsed. Anything unparseable is ignored."""
    out, dec, i = [], json.JSONDecoder(), 0
    while isinstance(text, str):
        i = text.find(DECISION_PREFIX, i)
        if i < 0:
            break
        i += len(DECISION_PREFIX)
        try:
            rec, _ = dec.raw_decode(text, i)
        except ValueError:
            continue
        if isinstance(rec, dict) and isinstance(rec.get("code"), str):
            out.append(rec)
    return out


def _strings(o):
    if isinstance(o, str):
        yield o
    elif isinstance(o, dict):
        for v in o.values():
            yield from _strings(v)
    elif isinstance(o, list):
        for v in o:
            yield from _strings(v)


def summarize(path, harness="claude"):
    """turns, result subtype, permission denials, cost, the run id the worker
    claimed (from its graph_next_work tool result) and whether it reported."""
    s = {"turns": 0, "result": None, "denials": 0, "denied_tools": [], "run_id": None, "reported": False,
         "cost": None, "mcp": {}, "started": False, "session_id": None, "usage": {}, "error_text": None,
         "result_text": None, "denied_inputs": [], "decisions": [],
         # what the worker reported: its status, error, node and data, and any
         # rejection reasons it saw (its claim card's last_rejection, its
         # report's verification)
         "report_status": None, "report_error": None, "report_node": None, "report_data": None,
         "rejection": None, "card_rejection": None, "card_skills": []}
    claims, reports = set(), set()
    try:  # the first non-JSON line (claude only: grok's output is one pretty-printed object), e.g. claude's "No conversation found with session ID: ..."
        if harness != "claude":
            raise OSError
        with open(path, errors="replace") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("{"):
                    s["error_text"] = s["error_text"] or line[:300]
                    s["decisions"] += decision_records(line)  # the hook's stderr line
    except OSError:
        pass
    for e in _events(path, harness):
        t = e.get("type")
        content = (e.get("message") or {}).get("content")
        content = content if isinstance(content, list) else []
        if t == "assistant":
            s["turns"] += 1
            for c in content:
                name = str(c.get("name", "")) if c.get("type") == "tool_use" else ""
                if name.endswith("graph_report"):
                    s["reported"] = True
                    reports.add(c.get("id"))
                    inp = c.get("input") if isinstance(c.get("input"), dict) else {}
                    s["report_status"] = inp.get("status") or s["report_status"]
                    s["report_error"] = inp.get("error") or s["report_error"]
                    s["report_node"] = inp.get("node_id") or s["report_node"]
                    if isinstance(inp.get("data"), dict):
                        s["report_data"] = inp["data"]
                elif name.endswith("graph_next_work"):
                    claims.add(c.get("id"))
        elif t == "user":
            for c in content:
                if c.get("type") != "tool_result":
                    continue
                text = tool_text(c.get("content"))
                s["decisions"] += decision_records(text)  # a denial's reason leads with the record
                if c.get("tool_use_id") in claims:
                    m = re.search(r'"run_id"\s*:\s*"([0-9a-f-]{36})"', text)
                    if m:
                        s["run_id"] = m.group(1)
                    s["card_rejection"] = rejection_of(text, "last_rejection") or s["card_rejection"]
                    s["card_skills"] = skills_of(text) or s["card_skills"]
                elif c.get("tool_use_id") in reports:
                    s["rejection"] = rejection_of(text, "verification") or s["rejection"]
        elif t == "system" and e.get("subtype") == "init":
            s["started"] = True
            s["session_id"] = e.get("session_id") or s["session_id"]
            s["mcp"] = {m.get("name"): m.get("status") for m in e.get("mcp_servers") or [] if isinstance(m, dict)}
        elif t == "result":
            s["result"] = e.get("subtype")
            s["result_text"] = e.get("result") if isinstance(e.get("result"), str) else None
            s["usage"] = e.get("usage") if isinstance(e.get("usage"), dict) else {}
            if (e.get("num_turns") or 0) > 0 or s["turns"] > 0:
                s["started"] = True
            s["session_id"] = s["session_id"] or e.get("session_id")
            denied = e.get("permission_denials") or []
            s["denials"] = len(denied)
            s["denied_tools"] = sorted({str(d.get("tool_name")) for d in denied if isinstance(d, dict)})
            s["denied_inputs"] = [d for d in denied if isinstance(d, dict)]
            for text in _strings(denied):
                s["decisions"] += decision_records(text)
            s["cost"] = e.get("total_cost_usd")
    s["started"] = s["started"] or s["turns"] > 0
    return s


DELIVER_SKILL = "deliver-via-github-pr"


def denial_class(s):
    """What a worker's denial means, from the governor's decision codes:
    (kind, record) with kind one of
      "salvage"      push_needs_approval_surface: push + PR + land for it
      "triage"       destructive_*: never salvaged, goes to triage
      "remediation"  graph_run_not_open: relaunched with the code in the prompt
      "denied"       any other denied/ask code: logged, not relaunched, not salvaged
      None           no record to go on: the caller falls back to the text match
    Only deny/ask records count (an allow is no denial). Severity decides when a
    worker was refused for several reasons: destructive, then run-not-open, then
    the push."""
    recs = [r for r in s.get("decisions") or [] if r.get("decision") in ("deny", "ask")]
    if not recs:
        return None, None
    for pick, kind in ((lambda c: c.startswith("destructive_"), "triage"),
                       (lambda c: c == "graph_run_not_open", "remediation"),
                       (lambda c: c == "push_needs_approval_surface", "salvage")):
        for r in recs:
            if pick(r["code"]):
                return kind, r
    return "denied", recs[0]


def skills_of(text):
    """Names of the skills on a claim card (its `skills` array), [] if unreadable."""
    try:
        card = json.loads(text)
    except ValueError:
        return []
    out = []
    # graph_next_work answers {"state": "claimed", "node": {...card...}}: the
    # skills (graph-level ones merged in) live on the node, not at the top.
    if isinstance(card, dict) and isinstance(card.get("node"), dict) and "skills" not in card:
        card = card["node"]
    for k in (card.get("skills") if isinstance(card, dict) else None) or []:
        if isinstance(k, str):
            out.append(k)
        elif isinstance(k, dict):
            # The api's card carries skills.AttachedSkill rows:
            # {"position", "config", "skill": {"id", "slug", "version", ...}} —
            # the name is NESTED under "skill". Reading only the flat forms
            # saw no name on any node, so every salvage on
            # enforcer-plugin-stack-hardening was SALVAGE-SKIPPED "the node's
            # skills do not include deliver-via-github-pr" while
            # GET /nodes/{id}/skills listed exactly that skill (2026-10-04).
            # The slug is the identifier the salvage rule compares against
            # (DELIVER_SKILL); a display name is only a fallback for a card
            # that carries nothing else. The MCP card has BOTH — {"slug",
            # "name", "version", "body"} — and preferring the name turned
            # "Deliver via GitHub pull request" into a non-match, so every
            # salvage was still skipped after 0.27.1 (2026-10-05).
            inner = k.get("skill") if isinstance(k.get("skill"), dict) else {}
            nm = (k.get("slug") or inner.get("slug") or k.get("key") or inner.get("key")
                  or k.get("name") or inner.get("name"))
            if nm:
                out.append(str(nm))
    return out


def tool_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "".join(c.get("text", "") for c in content if isinstance(c, dict))
    return ""


def rejection_of(text, field):
    """The rejection named by `field` in a graph tool's JSON answer, as a short
    string, or None: the claim card's `last_rejection` (any value), or a
    report's `verification` when its state is rejected/unsupported."""
    try:
        d = json.loads(text)
    except ValueError:
        return None
    v = d.get(field) if isinstance(d, dict) else None
    if not v:
        return None
    if field == "verification":
        if not isinstance(v, dict) or v.get("state") not in ("rejected", "unsupported"):
            return None
        v = {k: v[k] for k in ("state", "reason", "reasons", "criteria") if k in v}
    return clip(v if isinstance(v, str) else json.dumps(v, sort_keys=True), 1500)


def failed_outcome(s, rc):
    """None when the worker reported its node succeeded and was not rejected;
    otherwise {error, rejection}: what the next attempt must be told. A report
    whose status the stream does not show is taken as reported, not failed."""
    if s["reported"] and s["report_status"] in (None, "succeeded") and not s["rejection"]:
        return None
    if s["reported"] and s["report_status"] == "succeeded" and s["rejection"]:
        err = "reported succeeded but the verdict rejected it"
    elif s["report_error"]:
        err = s["report_error"]
    elif s["reported"]:
        err = "reported %s with no error" % (s["report_status"] or "an unknown status")
    else:
        err = "exited (code %s, result %s, %s turns) without reporting: %s" % (
            rc, s["result"], s["turns"], clip(s["result_text"] or "-", 300))
    # this run's verdict first; else the rejection its claim card carried
    return {"error": clip(err, 1500), "rejection": s["rejection"] or s["card_rejection"]}


def remediation_prompt(graph, node, path, branch, failures):
    """The prompt of a node's next launch after a failed attempt this session:
    the base prompt, then the previous error and rejection, and the rule."""
    last = failures[-1]
    lines = ["REMEDIATION LAUNCH (attempt %d this session). Your previous attempt at this node failed."
             % (len(failures) + 1),
             "Previous error: " + last["error"],
             "last_rejection: " + (last.get("rejection") or "none on record (read last_rejection on your claim card)"),
             "Fix the cause, not the symptom: find WHY it failed (missing context, a wrong assumption, a "
             "prerequisite) before you change anything, and say in your report what the cause was. If the cause "
             "is outside this node (a missing prerequisite, a human decision), graph_remember it structured and "
             "report failed: the dispatcher triages the node next, it does not relaunch it a third time."]
    return "\n".join(lines + [worker_prompt(graph, node, path, branch)])


TRIAGE_ACTIONS = ("revise", "prerequisite", "gate")


def triage_prompt(graph, tnode, failed, history):
    return "\n".join([
        "TRIAGE. You are a triage worker, not a task worker. Node `%s` (%s, type %s) failed (%d failed "
        "attempt(s) this dispatcher session); it is not relaunched until you decide what it lacks. Whatever its "
        "type (ops, gate, release included) you never do the node's own work; you only change what the graph says "
        "about it." % (failed["key"], failed["id"], failed.get("type"), len(history.get("failures") or [])),
        "Claim YOUR triage node: graph_next_work {graph: \"%s\", node: \"%s\", runner: \"%s\"}. Report THAT "
        "node only; never claim, heartbeat or report `%s`. Write no code, open no PR." % (
            graph, tnode["id"], tnode["key"], failed["key"]),
        "Read what failed (below, and graph_plan_status / the failed node's observations). Then decide EXACTLY ONE:",
        "  (a) revise: the description/brief/acceptance cannot be met as written, or the node's remaining work is "
        "something an agent can do (e.g. an ops node already merged and applied whose remainder is verification: "
        "retype it) -> data.triage = {action: \"revise\", reason, type?: \"task\", description?, acceptance?: [..], brief?: [..]}",
        "  (b) prerequisite: the thing it is waiting on is missing or not yet done -> "
        "data.triage = {action: \"prerequisite\", reason, nodes: [{key, title, description, acceptance: [..], brief?: [..]}]}; "
        "a node that already exists is named {key, existing: true}",
        "  (c) gate: the blocker is a human decision or a permission -> "
        "data.triage = {action: \"gate\", reason, decision: \"<the question a person must answer>\", gate_key?: \"<an existing gate node>\"}",
        "Put it in graph_report {status: \"succeeded\", data: {triage: {...}}} on your triage node, with a report "
        "naming the evidence (the failed runs' errors and verdicts) behind the choice. The dispatcher makes the "
        "graph writes from data.triage; you make none. If you cannot decide, report failed and say why.",
        "Failed node: " + clip(json.dumps({"key": failed["key"], "title": failed.get("title"),
                                           "description": failed.get("description"),
                                           "data": failed.get("data")}, sort_keys=True), 3000),
        "This session's failed attempts: " + clip(json.dumps(history.get("failures"), sort_keys=True), 3000),
        "Runs on record: " + clip(json.dumps(history.get("runs"), sort_keys=True), 2500),
        "Observations: " + clip(json.dumps(history.get("observations"), sort_keys=True), 2500)])


def triage_decision(data):
    """(decision, why-not): data.triage from a triage worker's report,
    validated, or (None, reason)."""
    t = (data or {}).get("triage") if isinstance(data, dict) else None
    if not isinstance(t, dict):
        return None, "no data.triage in the report"
    act = t.get("action")
    if act not in TRIAGE_ACTIONS:
        return None, "data.triage.action %r is not one of %s" % (act, "/".join(TRIAGE_ACTIONS))
    if not str(t.get("reason") or "").strip():
        return None, "data.triage.reason is empty"
    if act == "revise" and not any(t.get(k) for k in ("description", "acceptance", "brief", "type")):
        return None, "revise names no description, acceptance, brief or type"
    if act == "prerequisite":
        nodes = t.get("nodes")
        if not isinstance(nodes, list) or not nodes or not all(
                isinstance(n, dict) and n.get("key") and (n.get("title") or n.get("existing")) for n in nodes):
            return None, "prerequisite needs nodes: [{key, title, ...}] (or {key, existing: true})"
    if act == "gate" and not str(t.get("decision") or "").strip():
        return None, "gate names no decision"
    return t, ""


def parse_args(argv):
    p = argparse.ArgumentParser(prog="graph-dispatch", description=__doc__.split("\n")[0])
    p.add_argument("--graph", required=True, help="graph id")
    p.add_argument("--workers", type=int, default=3)
    p.add_argument("--repo-root", default=os.path.expanduser("~/apps"),
                   help="directory holding each data.repo checkout (default ~/apps)")
    p.add_argument("--dry-run", action="store_true", help="print what would launch; launch nothing")
    p.add_argument("--model", help="cap for nodes without an explicit model or user tier (e.g. sonnet)")
    p.add_argument("--max-turns", type=int, default=150, help="stop a worker past this many turns")
    p.add_argument("--max-budget-usd", type=float, help="passed to claude --max-budget-usd")
    p.add_argument("--max-attempts", type=int, default=2, help="launches per node per dispatcher session")
    p.add_argument("--types", default=DEFAULT_TYPES, help="node types to dispatch, or 'all'")
    p.add_argument("--interval", type=float, default=30, help="seconds between passes")
    p.add_argument("--heartbeat", type=float, default=120, help="seconds between merge-run heartbeats")
    p.add_argument("--land-timeout", type=int, default=3000)
    p.add_argument("--state-dir", help="logs and stop file (default ~/.config/enforcer/dispatch/<graph>)")
    p.add_argument("--stop-file", help="touch it to drain (default <state-dir>/STOP)")
    p.add_argument("--on-limit", choices=["wait", "exit"], default="wait",
                   help="when the harness reports a usage limit: wait for the reset (default) or exit 4")
    p.add_argument("--limit-backoff", type=float, default=1800,
                   help="seconds to hold when a limit message names no reset time")
    p.add_argument("--plugin-dir", action="append", default=[],
                   help="extra plugin dirs (default: the newest cached enforcer plugin, for the MCP server)")
    p.add_argument("--no-salvage", action="store_true",
                   help="do not push/PR/land a worker whose push or PR was denied")
    p.add_argument("--takeover", action="store_true",
                   help="replace a live dispatcher's lease on this graph (default: exit if one holds it)")
    p.add_argument("--no-lease", action="store_true", help="do not take the per-graph dispatcher lease")
    p.add_argument("--triage-grace", type=float, default=10,
                   help="minutes after a node's last run ended before it is triaged (default 10)")
    p.add_argument("--no-triage", action="store_true",
                   help="after the last failed attempt, leave the node for a person instead of triaging it")
    p.add_argument("--triage-model", default=TIER_MODEL["deep"],
                   help="model of the triage worker (default the deep tier, %s)" % TIER_MODEL["deep"])
    p.add_argument("--no-warm", action="store_true",
                   help="start every worker cold (no session reuse across nodes)")
    p.add_argument("--warm-max-nodes", type=int, default=5,
                   help="nodes one resumed session may run in all before it is retired (default 5)")
    p.add_argument("--warm-max-age", type=float, default=120,
                   help="minutes from a session's first launch after which it is retired (default 120)")
    p.add_argument("--harness", choices=HARNESSES, default="claude",
                   help="agent CLI that runs the workers (default claude)")
    p.add_argument("--grok", default=os.environ.get("GROK_BIN", "grok"))
    p.add_argument("--codex", default=os.environ.get("CODEX_BIN", "codex"))
    p.add_argument("--claude", default=os.environ.get("CLAUDE_BIN", "claude"))
    a = p.parse_args(argv)
    if a.workers < 1:
        p.error("--workers must be >= 1")
    if not a.state_dir:
        cfg = os.environ.get("ENFORCER_CONFIG_HOME") or os.path.expanduser("~/.config/enforcer")
        a.state_dir = os.path.join(cfg, "dispatch", a.graph)
        graph_lib.migrate_dir(os.path.expanduser("~/.cache/graph-dispatch/" + a.graph), a.state_dir)
    a.stop_file = a.stop_file or os.path.join(a.state_dir, "STOP")
    if not a.plugin_dir:
        found = sorted(glob.glob(claude_paths.plugin_cache_glob("enforcer", "*", claude_paths.MANIFEST_DIR)),
                       key=lambda q: [int(x) if x.isdigit() else x for x in re.split(r"[./]", q)])
        a.plugin_dir = [os.path.dirname(found[-1])] if found else []
    return a


def main(argv=None):
    try:
        a = parse_args(argv if argv is not None else sys.argv[1:])
    except SystemExit as e:
        return 5 if e.code else 0
    helper = os.environ.get("GRAPH_AUTH_HELPER") or (None if os.environ.get("GRAPH_API_KEY") else default_helper())
    key = os.environ.get("GRAPH_API_KEY")
    if not helper and not key:
        print("graph-dispatch: no credential: set GRAPH_AUTH_HELPER or GRAPH_API_KEY", file=sys.stderr)
        return 1
    if helper:
        helper = os.path.expanduser(helper)
    api = API(os.environ.get("GRAPH_BASE_URL", "https://api.instruxi.dev/api/v1/graph"), helper, key)
    if not a.dry_run:
        os.makedirs(a.state_dir, exist_ok=True)
    try:
        return Dispatcher(api, a).run()
    except APIError as e:
        print("graph-dispatch: %s" % e, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
