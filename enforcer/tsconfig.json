{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["types/*.d.ts", "src/**/*.mjs", "lib/governor/**/*.mjs", "lib/graph/**/*.mjs", "hooks/**/*.mjs"],
  "exclude": ["node_modules", "**/test/**", "**/*.test.mjs"]
}
