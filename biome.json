{
  "$schema": "./enforcer/node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**/*.mjs", "!**/node_modules", "!enforcer/lib/api/**", "!**/*.d.ts", "!**/fixtures", "!**/test-results", "!**/package-lock.json", "!**/dist"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useTemplate": "off", "useConst": "off" },
      "complexity": {
        "useOptionalChain": "off",
        "useLiteralKeys": "off",
        "noAdjacentSpacesInRegex": "off",
        "useRegexLiterals": "off",
        "noUselessEscapeInRegex": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noControlCharactersInRegex": "off",
        "noTemplateCurlyInString": "off",
        "noPrototypeBuiltins": "off",
        "useBiomeIgnoreFolder": "off"
      },
      "correctness": { "noUnusedFunctionParameters": "off" }
    }
  }
}
